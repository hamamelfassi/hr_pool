<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_governance_references" name="مراجع الحوكمة" parent="grc_backbone.menu_decision_configuration" action="grc_backbone.action_governance_reference" sequence="40"/>
    <menuitem id="menu_grc_variables" name="قاموس المتغيرات" parent="grc_backbone.menu_decision_configuration" action="grc_backbone.action_grc_variable" sequence="50"/>

    <record id="view_governance_reference_list" model="ir.ui.view">
        <field name="name">x_grc.governance_reference.list</field>
        <field name="model">x_grc.governance_reference</field>
        <field name="arch" type="xml">
            <list string="مراجع الحوكمة">
                <field name="x_code"/>
                <field name="x_name"/>
                <field name="x_reference_type_id" string="نوع مرجع الحوكمة"/>
                <field name="x_parent_reference_id" string="المرجع الأعلى"/>
                <field name="x_authority_name" string="جهة الإصدار"/>
                <field name="x_reference_date" string="تاريخ المرجع"/>
                <field name="x_status" string="الحالة" widget="badge"/>
                <field name="x_active" string="نشط"/>
            </list>
        </field>
    </record>

    <record id="view_governance_reference_form" model="ir.ui.view">
        <field name="name">x_grc.governance_reference.form</field>
        <field name="model">x_grc.governance_reference</field>
        <field name="arch" type="xml">
            <form string="مرجع الحوكمة">
                <header>
                    <button type="action"
                        name="grc_backbone.action_governance_reference_refresh_type"
                        string="تحديث نوع المرجع"
                        class="btn-primary"
                        invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_code"/>
                            <field name="x_reference_type_id" string="نوع مرجع الحوكمة"/>
                            <field name="x_reference_type" invisible="1"/>
                            <field name="x_parent_reference_id" string="المرجع الأعلى"/>
                            <field name="x_authority_name" string="جهة الإصدار"/>
                        </group>
                        <group>
                            <field name="x_reference_date" string="تاريخ المرجع"/>
                            <field name="x_version"/>
                            <field name="x_status" string="الحالة"/>
                            <field name="x_active" string="نشط"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="المرفقات والمصدر">
                            <group>
                                <group string="الملخص">
                                    <field name="x_summary_ar" string="الملخص العربي"/>
                                    <field name="x_summary_en" string="الملخص الإنجليزي"/>
                                </group>
                                <group string="المصدر">
                                    <field name="x_source_attachment_id" string="مرفق المصدر"
                                        options="{'no_create_edit': False}"/>
                                    <field name="x_source_url" string="رابط المصدر"
                                        placeholder="https://..."/>
                                </group>
                            </group>
                        </page>
                        <page string="البنود / الأحكام">
                            <field name="x_provision_ids"
                                context="{'default_x_reference_id': id, 'default_x_active': True, 'default_x_requirement_type': 'article', 'default_x_obligation_level': 'mandatory'}">
                                <list editable="bottom" string="البنود / الأحكام">
                                    <field name="x_sequence" string="التسلسل"/>
                                    <field name="x_code" string="كود البند"/>
                                    <field name="x_name" string="اسم البند"/>
                                    <field name="x_requirement_type" string="نوع المتطلب" widget="badge"/>
                                    <field name="x_obligation_level" string="مستوى الإلزام" widget="badge"/>
                                    <field name="x_active" string="نشط"/>
                                </list>
                            </field>
                        </page>
                        <page string="العلاقات">
                            <group string="العلاقات الصادرة">
                                <field name="x_outgoing_relation_ids"
                                    context="{'default_x_source_reference_id': id, 'default_x_active': True, 'default_x_relation_type': 'cites'}">
                                    <list editable="bottom" string="العلاقات الصادرة">
                                        <field name="x_sequence" string="التسلسل"/>
                                        <field name="x_name" string="اسم العلاقة"/>
                                        <field name="x_relation_type" string="نوع العلاقة" widget="badge"/>
                                        <field name="x_target_reference_id" string="المرجع الهدف"/>
                                        <field name="x_active" string="نشط"/>
                                    </list>
                                </field>
                            </group>
                            <group string="العلاقات الواردة">
                                <field name="x_incoming_relation_ids"
                                    context="{'default_x_target_reference_id': id, 'default_x_active': True, 'default_x_relation_type': 'cites'}">
                                    <list editable="bottom" string="العلاقات الواردة">
                                        <field name="x_sequence" string="التسلسل"/>
                                        <field name="x_name" string="اسم العلاقة"/>
                                        <field name="x_relation_type" string="نوع العلاقة" widget="badge"/>
                                        <field name="x_source_reference_id" string="المرجع المصدر"/>
                                        <field name="x_active" string="نشط"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="ملاحظات">
                            <field name="x_notes" string="ملاحظات"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_grc_variable_list" model="ir.ui.view">
        <field name="name">x_grc.variable.list</field>
        <field name="model">x_grc.variable</field>
        <field name="arch" type="xml">
            <list string="قاموس المتغيرات">
                <field name="x_key"/>
                <field name="x_label_ar"/>
                <field name="x_label_en"/>
                <field name="x_value_type"/>
                <field name="x_active" string="نشط"/>
            </list>
        </field>
    </record>

    <record id="view_grc_variable_form" model="ir.ui.view">
        <field name="name">x_grc.variable.form</field>
        <field name="model">x_grc.variable</field>
        <field name="arch" type="xml">
            <form string="Variable">
                <header>
                    <button type="action"
                        name="grc_backbone.action_grc_variable_refresh"
                        string="تحديث المتغير"
                        class="btn-primary"
                        invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_key"/>
                            <field name="x_value_type"/>
                            <field name="x_active" string="نشط"/>
                        </group>
                        <group>
                            <field name="x_label_ar"/>
                            <field name="x_label_en"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
