<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================= -->
        <!-- Marsellia Employee Separation Request                    -->
        <!-- F-0019 operational model                                 -->
        <!-- ========================================================= -->

        <record id="model_x_hr_employee_separation_request" model="ir.model">
            <field name="name">Employee Separation Request</field>
            <field name="model">x_hr.employee_separation_request</field>
            <field name="state">manual</field>
        </record>

        <record id="field_x_hr_employee_separation_request__x_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="model_id" ref="model_x_hr_employee_separation_request"/>
            <field name="field_description">Separation Request Label</field>
            <field name="ttype">char</field>
            <field name="readonly" eval="True"/>
            <field name="index" eval="True"/>
            <field name="translate" eval="True"/>
        </record>

        <record id="field_x_hr_employee_separation_request__x_employee_id" model="ir.model.fields">
            <field name="name">x_employee_id</field>
            <field name="model_id" ref="model_x_hr_employee_separation_request"/>
            <field name="field_description">Employee</field>
            <field name="ttype">many2one</field>
            <field name="relation">hr.employee</field>
            <field name="required" eval="True"/>
            <field name="on_delete">cascade</field>
            <field name="index" eval="True"/>
        </record>

        <record id="field_x_hr_employee_separation_request__x_reference_code" model="ir.model.fields">
            <field name="name">x_reference_code</field>
            <field name="model_id" ref="model_x_hr_employee_separation_request"/>
            <field name="field_description">Reference Code</field>
            <field name="ttype">char</field>
            <field name="readonly" eval="True"/>
            <field name="index" eval="True"/>
        </record>

        <record id="field_x_hr_employee_separation_request__x_document_reference" model="ir.model.fields">
            <field name="name">x_document_reference</field>
            <field name="model_id" ref="model_x_hr_employee_separation_request"/>
            <field name="field_description">Document Reference</field>
            <field name="ttype">char</field>
            <field name="readonly" eval="True"/>
            <field name="index" eval="True"/>
        </record>

        <record id="field_x_hr_employee_separation_request__x_state" model="ir.model.fields">
            <field name="name">x_state</field>
            <field name="model_id" ref="model_x_hr_employee_separation_request"/>
            <field name="field_description">State</field>
            <field name="ttype">selection</field>
            <field name="selection">[
                ('draft', 'Draft'),
                ('generated', 'Generated'),
                ('signature_requested', 'Signature Requested'),
                ('signed', 'Signed'),
                ('cancelled', 'Cancelled'),
                ('superseded', 'Superseded')
            ]</field>
            <field name="readonly" eval="True"/>
            <field name="index" eval="True"/>
        </record>

        <record id="field_x_hr_employee_separation_request__x_request_type" model="ir.model.fields">
            <field name="name">x_request_type</field>
            <field name="model_id" ref="model_x_hr_employee_separation_request"/>
            <field name="field_description">Request Type</field>
            <field name="ttype">selection</field>
            <field name="selection">[
                ('resignation', 'Resignation'),
                ('non_renewal', 'Non-Renewal of Contract'),
                ('medical_reasons', 'Medical Reasons'),
                ('other', 'Other')
            ]</field>
            <field name="required" eval="True"/>
            <field name="index" eval="True"/>
        </record>

        <record id="field_x_hr_employee_separation_request__x_effective_date" model="ir.model.fields">
            <field name="name">x_effective_date</field>
            <field name="model_id" ref="model_x_hr_employee_separation_request"/>
