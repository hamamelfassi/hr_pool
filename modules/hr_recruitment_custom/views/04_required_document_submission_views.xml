<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Pass 6B-2A                                                -->
    <!-- Controlled standalone fallback views for required document -->
    <!-- submissions. Prevents generic machine/generated form views. -->
    <!-- ========================================================= -->

    <record id="view_required_document_submission_list_controlled" model="ir.ui.view">
        <field name="name">x.hr.applicant.required.document.submission.list.controlled</field>
        <field name="model">x_hr.applicant_required_document_submission</field>
        <field name="priority" eval="5" />
        <field name="arch" type="xml">
            <list string="Required Document Submissions" create="false" delete="false">
                <field name="x_submission_sequence" string="#" readonly="1" />
                <field name="x_name" readonly="1" />
                <field name="x_applicant_id" readonly="1" />
                <field name="x_checklist_id" readonly="1" />
                <field name="x_document_type_id" readonly="1" />
                <field name="x_document_code" readonly="1" />
                <field name="x_state" />
                <field name="x_attachment_id"
                    options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" />
                <field name="create_date" string="Created On" readonly="1" />
                <field name="x_reviewed_on" readonly="1" />
            </list>
        </field>
    </record>

    <record id="view_required_document_submission_form_controlled" model="ir.ui.view">
        <field name="name">x.hr.applicant.required.document.submission.form.controlled</field>
        <field name="model">x_hr.applicant_required_document_submission</field>
        <field name="priority" eval="5" />
        <field name="arch" type="xml">
            <form string="Required Document Submission" create="false" delete="false">
                <header>
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_accept"
                        string="Accept Submission"
                        class="btn-primary"
                        invisible="x_state != 'submitted'" />
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_reject"
                        string="Reject Submission"
                        class="btn-secondary"
                        invisible="x_state != 'submitted'" />
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="submitted,accepted,rejected,superseded"
                        readonly="1" />
                </header>

                <sheet>
                    <group>
                        <group string="Submission Identity">
                            <field name="x_name" readonly="1" />
                            <field name="x_submission_sequence" readonly="1" />
                            <field name="x_document_code" readonly="1" />
                            <field name="x_applicant_id" readonly="1" />
                            <field name="x_source"
                                readonly="x_state != 'submitted'" />
                            <field name="x_source_submission_id"
                                readonly="x_state != 'submitted'"
                                placeholder="External submission ID, if any" />
                            <field name="x_source_reference"
                                readonly="x_state != 'submitted'"
                                placeholder="External reference, link label, or batch reference" />
                        </group>

                        <group string="Checklist Linkage">
                            <field name="x_checklist_id"
                                readonly="x_state != 'submitted'"
                                domain="[('x_applicant_id', '=', x_applicant_id)]" />
                            <field name="x_line_id"
                                readonly="x_state != 'submitted'"
                                domain="[('x_checklist_id', '=', x_checklist_id)]" />
                            <field name="x_document_type_id" readonly="1" />
                        </group>
                    </group>

                    <group string="Submitted Evidence">
                        <group>
                            <field name="x_attachment_id"
                                readonly="x_state != 'submitted'"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]"
                                context="{'default_res_model': 'hr.applicant', 'default_res_id': x_applicant_id}" />
                            <field name="x_submitted_by_user_id"
                                readonly="x_state != 'submitted'" />
                            <field name="create_date" string="Created On" readonly="1" />
                        </group>
                        <group>
                            <field name="x_document_number"
                                readonly="x_state != 'submitted'" />
                            <field name="x_issuing_authority"
                                readonly="x_state != 'submitted'"
                                placeholder="Issuing authority as written on the submitted document." />
                            <field name="x_place_of_issue"
                                readonly="x_state != 'submitted'"
                                placeholder="Place of issue as written on the submitted document." />
                            <field name="x_issue_date"
                                readonly="x_state != 'submitted'" />
                            <field name="x_expiry_date"
                                readonly="x_state != 'submitted'" />
                        </group>
                    </group>

                    <group string="Structured Data"
                        invisible="x_document_code not in ('qualification', 'birth_certificate', 'family_status', 'health_certificate', 'bank_information')">
                        <group string="Qualification"
                            invisible="x_document_code != 'qualification'">
                            <field name="x_qualification_type"
                                readonly="x_state != 'submitted'" />
                            <field name="x_qualification_subject"
                                readonly="x_state != 'submitted'" />
                        </group>
                        <group string="Birth Certificate"
                            invisible="x_document_code != 'birth_certificate'">
                            <field name="x_date_of_birth"
                                readonly="x_state != 'submitted'" />
                            <field name="x_place_of_birth"
                                readonly="x_state != 'submitted'" />
                            <field name="x_country_of_birth_id"
                                readonly="x_state != 'submitted'"
                                options="{'no_create': True, 'no_create_edit': True}" />
                        </group>
                        <group string="Family / Next of Kin"
                            invisible="x_document_code != 'family_status'">
                            <field name="x_family_paper_number"
                                readonly="x_state != 'submitted'" />
                            <field name="x_family_reference_number"
                                readonly="x_state != 'submitted'" />
                            <field name="x_next_of_kin_name"
                                readonly="x_state != 'submitted'" />
                            <field name="x_next_of_kin_phone"
                                readonly="x_state != 'submitted'" />
                        </group>
                        <group string="Health"
                            invisible="x_document_code != 'health_certificate'">
                            <field name="x_blood_type"
                                readonly="x_state != 'submitted'" />
                        </group>
                        <group string="Bank Information"
                            invisible="x_document_code != 'bank_information'">
                            <field name="x_bank_name"
                                readonly="x_state != 'submitted'" />
                            <field name="x_bank_branch"
                                readonly="x_state != 'submitted'" />
                            <field name="x_account_number"
                                readonly="x_state != 'submitted'" />
                            <field name="x_iban"
                                readonly="x_state != 'submitted'" />
                        </group>
                    </group>

                    <group string="Review">
                        <group>
                            <field name="x_reviewed_by_user_id" readonly="1" />
                            <field name="x_reviewed_on" readonly="1" />
                        </group>
                        <group>
                            <field name="x_reviewer_note"
                                readonly="x_state != 'submitted'"
                                placeholder="Reviewer note or rejection reason. Required before rejecting a submission." />
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="x_notes"
                            readonly="x_state != 'submitted'"
                            placeholder="Internal notes about this submitted evidence." />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>