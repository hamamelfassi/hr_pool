<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_identification_document_form" model="ir.ui.view">
        <field name="name">x.hr.employee.identification.document.form</field>
        <field name="model">x_hr.employee_identification_document</field>
        <field name="arch" type="xml">
            <form string="Employee Identification Document">
                <sheet>
                    <group>
                        <field name="x_employee_id"/>
                        <field name="x_document_type"/>
                        <field name="x_name"/>
                    </group>
                    <group>
                        <field name="x_document_number"/>
                        <field name="x_issued_by"/>
                        <field name="x_issue_place"/>
                        <field name="x_issue_date"/>
                        <field name="x_expiry_date"/>
                    </group>
                    <group string="Attachments">
                        <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Source Trace" invisible="not x_source_model and not x_source_res_id">
                        <field name="x_source_model" readonly="1"/>
                        <field name="x_source_res_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_identification_document_list" model="ir.ui.view">
        <field name="name">x.hr.employee.identification.document.list</field>
        <field name="model">x_hr.employee_identification_document</field>
        <field name="arch" type="xml">
            <list string="Employee Identification Documents">
                <field name="x_employee_id"/>
                <field name="x_document_type"/>
                <field name="x_document_number"/>
                <field name="x_issued_by"/>
                <field name="x_issue_place"/>
                <field name="x_issue_date"/>
                <field name="x_expiry_date"/>
                <field name="x_attachment_id"/>
            </list>
        </field>
    </record>

    <record id="action_employee_identification_documents" model="ir.actions.act_window">
        <field name="name">Employee Identification Documents</field>
        <field name="res_model">x_hr.employee_identification_document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hr_employee_form_inherit_identification_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.identification.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mcep_identification_documents" string="Identification">
                    <div class="alert alert-info" role="alert">
                        Identification records are used as a unified source for later forms such as declarations, custody, and assignments. Do not add duplicate records for the same document type unless there is a renewal or a different document.
                    </div>

                    <group string="ID Card">
                        <field name="x_identification_document_ids"
                            nolabel="1"
                            domain="[('x_document_type', '=', 'id_card')]"
                            context="{'default_x_employee_id': id, 'default_x_document_type': 'id_card'}">
                            <list editable="bottom">
                                <field name="x_document_number"/>
                                <field name="x_issued_by"/>
                                <field name="x_issue_place"/>
                                <field name="x_issue_date"/>
                                <field name="x_expiry_date"/>
                                <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </list>
                            <form>
                                <group>
                                    <field name="x_document_type" readonly="1"/>
                                    <field name="x_document_number"/>
                                    <field name="x_issued_by"/>
                                    <field name="x_issue_place"/>
                                    <field name="x_issue_date"/>
                                    <field name="x_expiry_date"/>
                                    <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_notes"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Passport">
                        <field name="x_identification_document_ids"
                            nolabel="1"
                            domain="[('x_document_type', '=', 'passport')]"
                            context="{'default_x_employee_id': id, 'default_x_document_type': 'passport'}">
                            <list editable="bottom">
                                <field name="x_document_number"/>
                                <field name="x_issued_by"/>
                                <field name="x_issue_place"/>
                                <field name="x_issue_date"/>
                                <field name="x_expiry_date"/>
                                <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </list>
                            <form>
                                <group>
                                    <field name="x_document_type" readonly="1"/>
                                    <field name="x_document_number"/>
                                    <field name="x_issued_by"/>
                                    <field name="x_issue_place"/>
                                    <field name="x_issue_date"/>
                                    <field name="x_expiry_date"/>
                                    <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_notes"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Driving License">
                        <field name="x_identification_document_ids"
                            nolabel="1"
                            domain="[('x_document_type', '=', 'driving_license')]"
                            context="{'default_x_employee_id': id, 'default_x_document_type': 'driving_license'}">
                            <list editable="bottom">
                                <field name="x_document_number"/>
                                <field name="x_issued_by"/>
                                <field name="x_issue_place"/>
                                <field name="x_issue_date"/>
                                <field name="x_expiry_date"/>
                                <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </list>
                            <form>
                                <group>
                                    <field name="x_document_type" readonly="1"/>
                                    <field name="x_document_number"/>
                                    <field name="x_issued_by"/>
                                    <field name="x_issue_place"/>
                                    <field name="x_issue_date"/>
                                    <field name="x_expiry_date"/>
                                    <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_notes"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Company ID Card">
                        <field name="x_identification_document_ids"
                            nolabel="1"
                            domain="[('x_document_type', '=', 'company_id_card')]"
                            context="{'default_x_employee_id': id, 'default_x_document_type': 'company_id_card'}">
                            <list editable="bottom">
                                <field name="x_document_number"/>
                                <field name="x_issued_by"/>
                                <field name="x_issue_place"/>
                                <field name="x_issue_date"/>
                                <field name="x_expiry_date"/>
                                <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </list>
                            <form>
                                <group>
                                    <field name="x_document_type" readonly="1"/>
                                    <field name="x_document_number"/>
                                    <field name="x_issued_by"/>
                                    <field name="x_issue_place"/>
                                    <field name="x_issue_date"/>
                                    <field name="x_expiry_date"/>
                                    <field name="x_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_notes"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
