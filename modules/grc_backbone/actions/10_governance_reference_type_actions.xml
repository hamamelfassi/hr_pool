    <record id="action_governance_reference_refresh_type" model="ir.actions.server">
        <field name="name">تحديث نوع المرجع</field>
        <field name="model_id" ref="grc_backbone.model_governance_reference"/>
        <field name="binding_model_id" ref="grc_backbone.model_governance_reference"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
legacy_codes = [
    'law',
    'regulation',
    'framework',
    'standard',
    'policy',
    'procedure',
    'decision',
    'letter',
    'memo',
    'meeting_minutes',
    'free_text',
    'other',
]

type_model = env['x_grc.governance_reference_type'].sudo()

for rec in records.sudo():
    vals = {}

    helper = rec.x_reference_type_id
    legacy = rec.x_reference_type or ''

    if not helper:
        code = legacy or 'other'
        helper = type_model.search([('x_code', '=', code)], limit=1)
        if helper:
            vals['x_reference_type_id'] = helper.id

    if helper and not legacy:
        helper_code = helper.x_code or 'other'
        if helper_code in legacy_codes:
            vals['x_reference_type'] = helper_code
        else:
            vals['x_reference_type'] = 'other'

    if vals:
        rec.write(vals)

action = {'type': 'ir.actions.client', 'tag': 'reload'}
        ]]></field>
    </record>
