<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_custody_type_list" model="ir.ui.view">
        <field name="name">x.hr.employee.custody.type.list</field>
        <field name="model">x_hr.employee_custody_type</field>
        <field name="arch" type="xml">
            <list string="Employee Custody Types">
                <field name="x_active"/>
                <field name="x_name"/>
                <field name="x_code"/>
                <field name="x_category" widget="badge"/>
                <field name="x_requires_return"/>
                <field name="x_requires_signature"/>
                <field name="x_uses_company_id_document"/>
                <field name="x_default_validity_months"/>
                <field name="x_replacement_fee_amount"/>
                <field name="x_replacement_fee_currency_label"/>
            </list>
        </field>
    </record>

    <record id="view_employee_custody_type_form" model="ir.ui.view">
        <field name="name">x.hr.employee.custody.type.form</field>
        <field name="model">x_hr.employee_custody_type</field>
        <field name="arch" type="xml">
            <form string="Employee Custody Type">
                <sheet>
<group>
                        <field name="x_active"/>
                        <field name="x_name"/>
                        <field name="x_code"/>
                        <field name="x_category"/>
                    </group>
                    <group string="Behavior">
                        <field name="x_requires_return"/>
                        <field name="x_requires_signature"/>
                        <field name="x_requires_identifier"/>
                        <field name="x_uses_company_id_document"/>
                    </group>
                    <group string="F-0011 Defaults">
                        <field name="x_default_validity_months"/>
                        <field name="x_replacement_fee_amount"/>
                        <field name="x_replacement_fee_currency_label"/>
                    </group>
                    <group string="Future Native Linkage">
                        <field name="x_future_native_link_model"/>
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_custody_item_list" model="ir.ui.view">
        <field name="name">x.hr.employee.custody.item.list</field>
        <field name="model">x_hr.employee_custody_item</field>
        <field name="arch" type="xml">
            <list string="Employee Custody Items" create="0">
                <field name="x_employee_id"/>
                <field name="x_custody_type_id"/>
                <field name="x_company_id_document_id" optional="hide"/>
                <field name="x_state"
                    widget="badge"
                    decoration-muted="x_state in ('draft', 'superseded')"
                    decoration-info="x_state == 'generated'"
                    decoration-warning="x_state == 'signature_requested'"
                    decoration-success="x_state in ('signed', 'returned')"
                    decoration-danger="x_state in ('lost', 'damaged', 'cancelled')"/>
                <field name="x_document_reference"/>
                <field name="x_issued_on"/>
                <field name="x_expected_return_on"/>
                <field name="x_returned_on"/>
                <field name="x_item_identifier"/>
                <field name="x_serial_number"/>
                <field name="x_responsible_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_employee_custody_item_form" model="ir.ui.view">
        <field name="name">x.hr.employee.custody.item.form</field>
        <field name="model">x_hr.employee_custody_item</field>
        <field name="arch" type="xml">
            <form string="Employee Custody Item">
                <header>
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,generated,signature_requested,signed,returned"
                        readonly="1"/>
                </header>
                <sheet>
                    <div class="mb-2">
                        <button name="%(action_employee_custody_generate_f0011_pdf)d"
                            type="action"
                            string="Generate PDF"
                            class="btn btn-primary"
                            invisible="x_custody_type_id == False or x_state in ('signature_requested', 'signed', 'returned', 'lost', 'damaged', 'cancelled')"/>
                        <button name="%(action_employee_custody_download_generated_pdf)d"
                            type="action"
                            string="Download Generated PDF"
                            icon="fa-download"
                            class="btn btn-secondary"
                            invisible="not x_pdf_attachment_id"/>
                        <button name="%(action_employee_custody_send_f0011_sign)d"
                            type="action"
                            string="Send to Sign"
                            class="btn btn-secondary"
                            invisible="x_state != 'generated' or not x_pdf_attachment_id or x_sign_request_res_id"/>
                        <button name="%(action_employee_custody_sync_f0011_sign)d"
                            type="action"
                            string="Sync"
                            class="btn btn-secondary"
                            invisible="not x_pdf_attachment_id or not x_sign_request_res_id"/>
                        <button name="%(action_employee_custody_download_signed_pdf)d"
                            type="action"
                            string="Download Signed PDF"
                            icon="fa-download"
                            class="btn btn-secondary"
                            invisible="not x_signed_attachment_id"/>
                        <button name="%(action_employee_custody_download_sign_certificate)d"
                            type="action"
                            string="Download Sign Certificate"
                            icon="fa-download"
                            class="btn btn-secondary"
                            invisible="not x_sign_certificate_attachment_id"/>
                        <span class="mx-1"/>
                        <button name="%(action_employee_custody_mark_returned)d"
                            type="action"
                            string="Mark Returned"
                            class="btn btn-secondary"
                            invisible="x_state in ('draft', 'returned', 'lost', 'damaged', 'cancelled', 'superseded')"/>
                        <button name="%(action_employee_custody_mark_lost)d"
                            type="action"
                            string="Mark Lost"
                            class="btn btn-secondary"
                            invisible="x_state in ('returned', 'lost', 'cancelled', 'superseded')"/>
                        <button name="%(action_employee_custody_mark_damaged)d"
                            type="action"
                            string="Mark Damaged"
                            class="btn btn-secondary"
                            invisible="x_state in ('returned', 'damaged', 'cancelled', 'superseded')"/>
                    </div>
                    <group>
                        <field name="x_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_custody_type_id" options="{'no_create_edit': True}"/>
                        <field name="x_company_id_document_id"
                            domain="[('x_employee_id', '=', x_employee_id), ('x_document_type', '=', 'company_id_card')]"
                            options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_name" readonly="1"/>
                        <field name="x_reference_code" readonly="1"/>
                        <field name="x_document_reference" readonly="1"/>
                    </group>
                    <group string="Custody Details">
                        <field name="x_issued_on"/>
                        <field name="x_expected_return_on"/>
                        <field name="x_returned_on"/>
                        <field name="x_quantity"/>
                        <field name="x_item_identifier"/>
                        <field name="x_serial_number"/>
                        <field name="x_replacement_value"/>
                    </group>
                    <group string="Description and Condition">
                        <field name="x_item_description"/>
                        <field name="x_condition_on_issue"/>
                        <field name="x_condition_on_return"/>
                    </group>
                    <group string="Lifecycle Artifacts" invisible="1">
                        <field name="x_pdf_attachment_id" readonly="1"/>
                        <field name="x_signed_attachment_id" readonly="1"/>
                        <field name="x_sign_certificate_attachment_id" readonly="1"/>
                        <field name="x_sign_request_res_id" readonly="1"/>
                        <field name="x_sign_request_state" readonly="1"/>
                        <field name="x_sign_request_reference" readonly="1"/>
                        <field name="x_sign_request_url" readonly="1"/>
                        <field name="x_generated_on" readonly="1"/>
                        <field name="x_sent_on" readonly="1"/>
                        <field name="x_signed_on" readonly="1"/>
                    </group>
                    <group string="Manual Decision">
                        <field name="x_manual_decision_number"/>
                        <field name="x_manual_decision_date"/>
                        <field name="x_manual_decision_attachment_id"
                            options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Clearance Hook">
                        <field name="x_clearance_required"/>
                        <field name="x_clearance_status" readonly="1"/>
                        <field name="x_clearance_notes"/>
                    </group>
                    <group string="Ownership and Notes">
                        <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_custody_items" model="ir.actions.act_window">
        <field name="name">Employee Custody Items</field>
        <field name="res_model">x_hr.employee_custody_item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_employee_custody_item_create" model="ir.actions.act_window">
        <field name="name">Add Custody Item</field>
        <field name="res_model">x_hr.employee_custody_item</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_custody_item_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_employee_custody_types" model="ir.actions.act_window">
        <field name="name">Employee Custody Types</field>
        <field name="res_model">x_hr.employee_custody_type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hr_employee_form_inherit_employee_custody" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.custody</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mcep_employee_custody_assets" string="Custody and Assets">
                    <div class="alert alert-info" role="alert">
                        Custody records track company property issued to the employee. Company ID card custody uses the employee Identification tab as the card source.
                    </div>

                    <div class="mb-2">
                        <button name="%(action_employee_custody_item_create)d"
                            type="action"
                            string="Add Custody Item"
                            class="btn btn-primary"
                            context="{'default_x_employee_id': id}"/>
                    </div>

                    <field name="x_custody_item_ids"
                        nolabel="1"
                        context="{'default_x_employee_id': id}">
                        <list create="0">
                            <field name="x_custody_type_id"/>
                            <field name="x_company_id_document_id" optional="hide"/>
                            <field name="x_state"
                                widget="badge"
                                decoration-muted="x_state in ('draft', 'superseded')"
                                decoration-info="x_state == 'generated'"
                                decoration-warning="x_state == 'signature_requested'"
                                decoration-success="x_state in ('signed', 'returned')"
                                decoration-danger="x_state in ('lost', 'damaged', 'cancelled')"/>
                            <field name="x_document_reference"/>
                            <field name="x_issued_on"/>
                            <field name="x_expected_return_on"/>
                            <field name="x_returned_on"/>
                            <field name="x_item_identifier"/>
                            <field name="x_serial_number"/>
                            <field name="x_responsible_user_id"/>
                        </list>
                        <form>
                            <header>
                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="draft,generated,signature_requested,signed,returned"
                                    readonly="1"/>
                            </header>
                            <sheet>
                                <div class="mb-2">
                                    <button name="%(action_employee_custody_generate_f0011_pdf)d"
                                        type="action"
                                        string="Generate PDF"
                                        class="btn btn-primary"
                                        invisible="x_custody_type_id == False or x_state in ('signature_requested', 'signed', 'returned', 'lost', 'damaged', 'cancelled')"/>
                                    <button name="%(action_employee_custody_download_generated_pdf)d"
                                        type="action"
                                        string="Download Generated PDF"
                                        icon="fa-download"
                                        class="btn btn-secondary"
                                        invisible="not x_pdf_attachment_id"/>
                                    <button name="%(action_employee_custody_send_f0011_sign)d"
                                        type="action"
                                        string="Send to Sign"
                                        class="btn btn-secondary"
                                        invisible="x_state != 'generated' or not x_pdf_attachment_id or x_sign_request_res_id"/>
                                    <button name="%(action_employee_custody_sync_f0011_sign)d"
                                        type="action"
                                        string="Sync"
                                        class="btn btn-secondary"
                                        invisible="not x_pdf_attachment_id or not x_sign_request_res_id"/>
                                    <button name="%(action_employee_custody_download_signed_pdf)d"
                                        type="action"
                                        string="Download Signed PDF"
                                        icon="fa-download"
                                        class="btn btn-secondary"
                                        invisible="not x_signed_attachment_id"/>
                                    <button name="%(action_employee_custody_download_sign_certificate)d"
                                        type="action"
                                        string="Download Sign Certificate"
                                        icon="fa-download"
                                        class="btn btn-secondary"
                                        invisible="not x_sign_certificate_attachment_id"/>
                                    <span class="mx-1"/>
                                    <button name="%(action_employee_custody_mark_returned)d"
                                        type="action"
                                        string="Mark Returned"
                                        class="btn btn-secondary"
                                        invisible="x_state in ('draft', 'returned', 'lost', 'damaged', 'cancelled', 'superseded')"/>
                                    <button name="%(action_employee_custody_mark_lost)d"
                                        type="action"
                                        string="Mark Lost"
                                        class="btn btn-secondary"
                                        invisible="x_state in ('returned', 'lost', 'cancelled', 'superseded')"/>
                                    <button name="%(action_employee_custody_mark_damaged)d"
                                        type="action"
                                        string="Mark Damaged"
                                        class="btn btn-secondary"
                                        invisible="x_state in ('returned', 'damaged', 'cancelled', 'superseded')"/>
                                </div>
                                <group>
                                    <field name="x_employee_id" readonly="1" force_save="1"/>
                                    <field name="x_custody_type_id" options="{'no_create_edit': True}"/>
                                    <field name="x_company_id_document_id"
                                        domain="[('x_employee_id', '=', x_employee_id), ('x_document_type', '=', 'company_id_card')]"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_name" readonly="1"/>
                                    <field name="x_reference_code" readonly="1"/>
                                    <field name="x_document_reference" readonly="1"/>
                                </group>
                                <group string="Custody Details">
                                    <field name="x_issued_on"/>
                                    <field name="x_expected_return_on"/>
                                    <field name="x_returned_on"/>
                                    <field name="x_quantity"/>
                                    <field name="x_item_identifier"/>
                                    <field name="x_serial_number"/>
                                    <field name="x_replacement_value"/>
                                </group>
                                <group string="Description and Condition">
                                    <field name="x_item_description"/>
                                    <field name="x_condition_on_issue"/>
                                    <field name="x_condition_on_return"/>
                                </group>
                                <group string="Lifecycle Artifacts" invisible="1">
                                    <field name="x_pdf_attachment_id" readonly="1"/>
                                    <field name="x_signed_attachment_id" readonly="1"/>
                                    <field name="x_sign_certificate_attachment_id" readonly="1"/>
                                    <field name="x_sign_request_res_id" readonly="1"/>
                                    <field name="x_sign_request_state" readonly="1"/>
                                    <field name="x_sign_request_reference" readonly="1"/>
                                    <field name="x_sign_request_url" readonly="1"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_sent_on" readonly="1"/>
                                    <field name="x_signed_on" readonly="1"/>
                                </group>
                                <group string="Manual Decision">
                                    <field name="x_manual_decision_number"/>
                                    <field name="x_manual_decision_date"/>
                                    <field name="x_manual_decision_attachment_id"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Clearance Hook">
                                    <field name="x_clearance_required"/>
                                    <field name="x_clearance_status" readonly="1"/>
                                    <field name="x_clearance_notes"/>
                                </group>
                                <group string="Ownership and Notes">
                                    <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_notes"/>
                                </group>
                            </sheet>
                        </form>
                    </field>

                </page>
            </xpath>
        </field>
    </record>

</odoo>
