<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_separation_request_list" model="ir.ui.view">
        <field name="name">x.hr.employee.separation.request.list</field>
        <field name="model">x_hr.employee_separation_request</field>
        <field name="arch" type="xml">
            <list string="Employee Separation Requests">
                <field name="x_employee_id"/>
                <field name="x_state"
                    widget="badge"
                    decoration-muted="x_state in ('draft', 'superseded')"
                    decoration-info="x_state == 'generated'"
                    decoration-warning="x_state == 'signature_requested'"
                    decoration-success="x_state == 'signed'"
                    decoration-danger="x_state == 'cancelled'"/>
                <field name="x_request_type"/>
                <field name="x_effective_date"/>
                <field name="x_document_reference"/>
                <field name="x_direct_manager_employee_id" optional="show"/>
                <field name="x_hr_user_id" optional="show"/>
                <field name="x_general_manager_user_id" optional="show"/>
                <field name="x_responsible_user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_employee_separation_request_form" model="ir.ui.view">
        <field name="name">x.hr.employee.separation.request.form</field>
        <field name="model">x_hr.employee_separation_request</field>
        <field name="arch" type="xml">
            <form string="Employee Separation Request">
                <header>
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,generated,signature_requested,signed"
                        readonly="1"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Separation requests cover F-0019. This slice adds the controlled request surface only; normalization, PDF generation, and Odoo Sign actions come next.
                    </div>
                    <group>
                        <field name="x_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_name" readonly="1"/>
                        <field name="x_reference_code" readonly="1"/>
                        <field name="x_document_reference" readonly="1"/>
                    </group>
                    <group string="Request Details">
                        <field name="x_request_type"/>
                        <field name="x_effective_date"/>
                        <field name="x_other_reason_description" invisible="x_request_type != 'other'"/>
                        <field name="x_employee_notes"/>
                    </group>
                    <group string="Approval Metadata">
                        <field name="x_direct_manager_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_direct_manager_user_id" invisible="1" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Lifecycle Artifacts" invisible="1">
                        <field name="x_pdf_attachment_id" readonly="1"/>
                        <field name="x_signed_attachment_id" readonly="1"/>
                        <field name="x_sign_certificate_attachment_id" readonly="1"/>
                        <field name="x_sign_request_res_id" readonly="1"/>
                        <field name="x_sign_request_state" readonly="1"/>
                        <field name="x_sign_request_reference" readonly="1"/>
                        <field name="x_sign_request_url" readonly="1"/>
                        <field name="x_generated_on" readonly="1"/>
                        <field name="x_sent_on" readonly="1"/>
                        <field name="x_signed_on" readonly="1"/>
                    </group>
                    <group string="Manual Decision">
                        <field name="x_manual_decision_number"/>
                        <field name="x_manual_decision_date"/>
                        <field name="x_manual_decision_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Notes">
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_separation_requests" model="ir.actions.act_window">
        <field name="name">Employee Separation Requests</field>
        <field name="res_model">x_hr.employee_separation_request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="action_employee_separation_request_create" model="ir.actions.act_window">
        <field name="name">New Separation Request</field>
        <field name="res_model">x_hr.employee_separation_request</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_separation_request_form"/>
        <field name="target">new</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="view_hr_employee_form_inherit_employee_separation_requests" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.separation.requests</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mcep_employee_separation_requests" string="Separation">
                    <div class="alert alert-info" role="alert">
                        Separation requests here are Marsellia official F-0019 records. This pass focuses on governed request capture, PDF generation, and four-role Sign workflow without native offboarding, contract closing, payroll, final settlement, custody clearance, approval, or GRC integration.
                    </div>
                    <div class="mb-2">
                        <button name="%(action_employee_separation_request_create)d"
                            type="action"
                            string="New Separation Request"
                            class="btn btn-primary"
                            context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_responsible_user_id': uid}"/>
                    </div>
                    <field name="x_separation_request_ids"
                        nolabel="1"
                        context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_responsible_user_id': uid}">
                        <list create="0">
                            <field name="x_state"
                                widget="badge"
                                decoration-muted="x_state in ('draft', 'superseded')"
                                decoration-info="x_state == 'generated'"
                                decoration-warning="x_state == 'signature_requested'"
                                decoration-success="x_state == 'signed'"
                                decoration-danger="x_state == 'cancelled'"/>
                            <field name="x_request_type"/>
                            <field name="x_effective_date"/>
                            <field name="x_document_reference"/>
                            <field name="x_direct_manager_employee_id" optional="show"/>
                            <field name="x_hr_user_id" optional="show"/>
                            <field name="x_general_manager_user_id" optional="show"/>
                            <field name="x_responsible_user_id" optional="show"/>
                        </list>
                        <form>
                            <header>
                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="draft,generated,signature_requested,signed"
                                    readonly="1"/>
                            </header>
                            <sheet>
                                <div class="alert alert-info" role="alert">
                                    Separation requests cover F-0019. This slice adds the controlled request surface only; normalization, PDF generation, and Odoo Sign actions come next.
                                </div>
                                <group>
                                    <field name="x_employee_id" readonly="1" force_save="1"/>
                                    <field name="x_name" readonly="1"/>
                                    <field name="x_reference_code" readonly="1"/>
                                    <field name="x_document_reference" readonly="1"/>
                                </group>
                                <group string="Request Details">
                                    <field name="x_request_type"/>
                                    <field name="x_effective_date"/>
                                    <field name="x_other_reason_description" invisible="x_request_type != 'other'"/>
                                    <field name="x_employee_notes"/>
                                </group>
                                <group string="Approval Metadata">
                                    <field name="x_direct_manager_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_direct_manager_user_id" invisible="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Lifecycle Artifacts" invisible="1">
                                    <field name="x_pdf_attachment_id" readonly="1"/>
                                    <field name="x_signed_attachment_id" readonly="1"/>
                                    <field name="x_sign_certificate_attachment_id" readonly="1"/>
                                    <field name="x_sign_request_res_id" readonly="1"/>
                                    <field name="x_sign_request_state" readonly="1"/>
                                    <field name="x_sign_request_reference" readonly="1"/>
                                    <field name="x_sign_request_url" readonly="1"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_sent_on" readonly="1"/>
                                    <field name="x_signed_on" readonly="1"/>
                                </group>
                                <group string="Manual Decision">
                                    <field name="x_manual_decision_number"/>
                                    <field name="x_manual_decision_date"/>
                                    <field name="x_manual_decision_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Notes">
                                    <field name="x_notes"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
