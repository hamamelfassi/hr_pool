        <record id="field_hr_applicant_x_employment_identity_ready" model="ir.model.fields">
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="name">x_employment_identity_ready</field>
            <field name="field_description">Employment Identity Ready</field>
            <field name="ttype">boolean</field>
            <field name="readonly" eval="True"/>
        </record>

        <record id="field_hr_applicant_x_employment_identity_count" model="ir.model.fields">
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
