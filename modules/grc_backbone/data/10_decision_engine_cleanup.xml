    <delete id="menu_contract_templates" model="ir.ui.menu"/>
    <delete id="menu_tenders" model="ir.ui.menu"/>
    <delete id="menu_grc_commercial" model="ir.ui.menu"/>

    <!-- Old task-template menu -->
    <delete id="menu_task_templates" model="ir.ui.menu"/>

    <!-- Old fragmented governance actions now replaced by Governance Reference filtered actions -->
    <delete id="action_framework" model="ir.actions.act_window"/>
    <delete id="action_policy" model="ir.actions.act_window"/>
    <delete id="action_provision" model="ir.actions.act_window"/>
    <delete id="action_decision" model="ir.actions.act_window"/>
