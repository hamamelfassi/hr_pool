        <record id="employee_leave_policy_annual_leave" model="x_hr.employee_leave_type_policy">
            <field name="x_active" eval="True"/>
            <field name="x_name">Annual Leave</field>
            <field name="x_code">annual_leave</field>
            <field name="x_form_code">MCEP-HR-F-0016</field>
            <field name="x_form_title">Leave Request</field>
            <field name="x_leave_category">annual_leave</field>
            <field name="x_work_entry_type_id" ref="hr_work_entry.generic_work_entry_type_legal_leave"/>
            <field name="x_requires_balance_check" eval="True"/>
            <field name="x_requires_acting_employee" eval="True"/>
            <field name="x_requires_address_during_leave" eval="True"/>
            <field name="x_requires_contact_during_leave" eval="True"/>
            <field name="x_requires_direct_manager_approval" eval="True"/>
            <field name="x_requires_hr_approval" eval="True"/>
            <field name="x_requires_general_manager_approval" eval="True"/>
            <field name="x_default_entitlement_days" eval="30.0"/>
            <field name="x_default_emergency_limit_days" eval="0.0"/>
            <field name="x_notes">Marsellia annual leave policy. Native bridge target is Odoo Paid Time Off. Balance values remain manually verified in Pass 19.</field>
        </record>

