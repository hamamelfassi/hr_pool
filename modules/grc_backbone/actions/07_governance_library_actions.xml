<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_governance_reference_relation" model="ir.actions.act_window">
        <field name="name">Governance Reference Relations</field>
        <field name="res_model">x_grc.governance_reference_relation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_active': True}</field>
    </record>

    <record id="action_governance_provision" model="ir.actions.act_window">
        <field name="name">Governance Provisions</field>
        <field name="res_model">x_grc.governance_provision</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_active': True, 'default_x_requirement_type': 'article', 'default_x_obligation_level': 'mandatory'}</field>
    </record>

    <record id="action_governance_text_pattern" model="ir.actions.act_window">
        <field name="name">Governance Text Patterns</field>
        <field name="res_model">x_grc.governance_text_pattern</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_active': True, 'default_x_pattern_role': 'article'}</field>
    </record>
    <record id="action_governance_provision_open_form" model="ir.actions.server">
        <field name="name">فتح بند الحوكمة</field>
        <field name="model_id" ref="grc_backbone.model_governance_provision"/>
        <field name="binding_model_id" ref="grc_backbone.model_governance_provision"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = False

rec = records[:1]
if rec:
    title = rec.x_name or rec.x_code or 'بند حوكمة'
    action = {
        'type': 'ir.actions.act_window',
        'name': title,
        'res_model': 'x_grc.governance_provision',
        'res_id': rec.id,
        'view_mode': 'form',
        'views': [(False, 'form')],
        'target': 'current',
        'context': {
            'default_x_reference_id': rec.x_reference_id.id if rec.x_reference_id else False,
            'default_x_active': True,
            'default_x_requirement_type': 'article',
            'default_x_obligation_level': 'mandatory',
        },
    }
        ]]></field>
    </record>

</odoo>
