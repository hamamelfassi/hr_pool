<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_performance_evaluation_line_list" model="ir.ui.view">
        <field name="name">x.hr.employee.performance.evaluation.line.list</field>
        <field name="model">x_hr.employee_performance_evaluation_line</field>
        <field name="arch" type="xml">
            <list string="Performance Evaluation Lines" editable="bottom">
                <field name="x_sequence"/>
                <field name="x_item_code"/>
                <field name="x_item_label_ar"/>
                <field name="x_item_label_en"/>
                <field name="x_score"/>
                <field name="x_max_score" readonly="1"/>
                <field name="x_notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_employee_performance_evaluation_list" model="ir.ui.view">
        <field name="name">x.hr.employee.performance.evaluation.list</field>
        <field name="model">x_hr.employee_performance_evaluation</field>
        <field name="arch" type="xml">
            <list string="Employee Performance Evaluations">
                <field name="x_employee_id"/>
                <field name="x_state"
                    widget="badge"
                    decoration-muted="x_state in ('draft', 'superseded')"
                    decoration-info="x_state == 'generated'"
                    decoration-warning="x_state == 'signature_requested'"
                    decoration-success="x_state == 'signed'"
                    decoration-danger="x_state == 'cancelled'"/>
                <field name="x_period_date_from"/>
                <field name="x_period_date_to"/>
                <field name="x_total_score"/>
                <field name="x_max_score"/>
                <field name="x_score_percentage"/>
                <field name="x_grade"
                    widget="badge"
                    decoration-muted="x_grade == 'not_scored'"
                    decoration-info="x_grade in ('good', 'very_good')"
                    decoration-success="x_grade == 'excellent'"
                    decoration-warning="x_grade == 'acceptable'"/>
                <field name="x_document_reference"/>
                <field name="x_direct_manager_employee_id" optional="show"/>
                <field name="x_hr_user_id" optional="show"/>
                <field name="x_responsible_user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_employee_performance_evaluation_form" model="ir.ui.view">
        <field name="name">x.hr.employee.performance.evaluation.form</field>
        <field name="model">x_hr.employee_performance_evaluation</field>
        <field name="arch" type="xml">
            <form string="Employee Performance Evaluation">
                <header>
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,generated,signature_requested,signed"
                        readonly="1"/>
                    <button type="action"
                        name="%(action_employee_performance_evaluation_download_generated_pdf)d"
                        string=""
                        title="Download Generated PDF"
                        icon="fa-download"
                        class="btn-link"
                        invisible="not x_pdf_attachment_id"/>
                    <button type="action"
                        name="%(action_employee_performance_evaluation_download_signed_pdf)d"
                        string=""
                        title="Download Signed PDF"
                        icon="fa-file-pdf-o"
                        class="btn-link"
                        invisible="not x_signed_attachment_id"/>
                    <button type="action"
                        name="%(action_employee_performance_evaluation_download_sign_certificate)d"
                        string=""
                        title="Download Sign Certificate"
                        icon="fa-certificate"
                        class="btn-link"
                        invisible="not x_sign_certificate_attachment_id"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Performance evaluations cover F-0018. Scoring, PDF generation, and the three-role Odoo Sign lifecycle are handled on this evaluation record.
                    </div>

                    <!-- MCEP performance evaluation unified controls start -->

                    <div class="mcep-performance-evaluation-controls" style="width: 100%; margin: 12px 0 18px 0;">

                        <div class="o_horizontal_separator">Workflow and Artifacts</div>

                        <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-top: 8px;">

                            <button name="%(action_employee_performance_evaluation_generate_pdf)d"

                                type="action"

                                string="Generate PDF"

                                class="btn btn-primary"

                                invisible="x_state in ('signature_requested', 'signed')"/>
                            <button name="%(action_employee_performance_evaluation_send_sign)d"
                                type="action"
                                string="Send to Sign"
                                class="btn btn-secondary"
                                invisible="x_state != 'generated' or x_sign_request_res_id"/>
                            <button name="%(action_employee_performance_evaluation_sync_sign)d"
                                type="action"
                                string="Sync"
                                class="btn btn-secondary"
                                invisible="not x_sign_request_res_id"/>

                            <button type="action"

                                name="%(action_employee_performance_evaluation_download_generated_pdf)d"

                                string="Generated PDF"

                                icon="fa-download"

                                class="btn btn-secondary"

                                invisible="not x_pdf_attachment_id"/>

                            <button type="action"

                                name="%(action_employee_performance_evaluation_download_signed_pdf)d"

                                string="Signed PDF"

                                icon="fa-file-pdf-o"

                                class="btn btn-secondary"

                                invisible="not x_signed_attachment_id"/>

                            <button type="action"

                                name="%(action_employee_performance_evaluation_download_sign_certificate)d"

                                string="Certificate"

                                icon="fa-certificate"

                                class="btn btn-secondary"

                                invisible="not x_sign_certificate_attachment_id"/>

                        </div>

                    </div>

                    <!-- MCEP performance evaluation unified controls end -->
                    <group>
                        <field name="x_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_name" readonly="1"/>
                        <field name="x_reference_code" readonly="1"/>
                        <field name="x_document_reference" readonly="1"/>
                    </group>
                    <group string="Evaluation Period">
                        <field name="x_period_date_from"/>
                        <field name="x_period_date_to"/>
                    </group>
                    <group string="Evaluation Result">
                        <field name="x_total_score" readonly="1"/>
                        <field name="x_max_score" readonly="1"/>
                        <field name="x_score_percentage" readonly="1"/>
                        <field name="x_grade" readonly="1"/>
                        <field name="x_star_rating" widget="priority" readonly="1"/>
                    </group>
                    <group string="Evaluation Items" col="1" colspan="2">
                        <field name="x_line_ids" nolabel="1" readonly="x_state != 'draft'">
                            <list editable="bottom" create="false" delete="false" default_order="x_sequence asc">
                                <field name="x_sequence" string="#" readonly="1" width="48px"/>
                                <field name="x_item_label_ar" string="Evaluation Item" readonly="1" width="72%"/>
                                <field name="x_score"
                                    string="Score"
                                    width="90px"
                                    options="{'type': 'number', 'min': 1, 'max': 5}"/>
                                <field name="x_notes" optional="hide" width="160px"/>
                            </list>
                            <form string="Performance Evaluation Item">
                                <group>
                                    <field name="x_sequence" readonly="1"/>
                                    <field name="x_item_code" readonly="1"/>
                                    <field name="x_item_label_ar" readonly="1"/>
                                    <field name="x_item_label_en" readonly="1"/>
                                    <field name="x_score"
                                        options="{'type': 'number', 'min': 1, 'max': 5}"/>
                                    <field name="x_notes"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Recommendations">
                        <field name="x_direct_manager_recommendation"/>
                        <field name="x_hr_manager_recommendation"/>
                    </group>
                    <group string="Approval Metadata">
                        <field name="x_direct_manager_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_direct_manager_user_id" invisible="1" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Lifecycle Artifacts" invisible="1">
                        <field name="x_pdf_attachment_id" readonly="1"/>
                        <field name="x_signed_attachment_id" readonly="1"/>
                        <field name="x_sign_certificate_attachment_id" readonly="1"/>
                        <field name="x_sign_request_res_id" readonly="1"/>
                        <field name="x_sign_request_state" readonly="1"/>
                        <field name="x_sign_request_reference" readonly="1"/>
                        <field name="x_sign_request_url" readonly="1"/>
                        <field name="x_generated_on" readonly="1"/>
                        <field name="x_sent_on" readonly="1"/>
                        <field name="x_signed_on" readonly="1"/>
                    </group>
                    <group string="Manual Decision">
                        <field name="x_manual_decision_number"/>
                        <field name="x_manual_decision_date"/>
                        <field name="x_manual_decision_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Notes">
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_performance_evaluations" model="ir.actions.act_window">
        <field name="name">Employee Performance Evaluations</field>
        <field name="res_model">x_hr.employee_performance_evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_max_score': 60, 'default_x_grade': 'not_scored', 'default_x_star_rating': '0', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="action_employee_performance_evaluation_create" model="ir.actions.act_window">
        <field name="name">New Performance Evaluation</field>
        <field name="res_model">x_hr.employee_performance_evaluation</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_performance_evaluation_form"/>
        <field name="target">new</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_max_score': 60, 'default_x_grade': 'not_scored', 'default_x_star_rating': '0', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="view_hr_employee_form_inherit_employee_performance_evaluations" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.performance.evaluations</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mcep_employee_performance_evaluations" string="Evaluations">
                    <div class="alert alert-info" role="alert">
                        Performance evaluations here are Marsellia official F-0018 records. This pass focuses on governed scoring, PDF generation, and three-role Sign workflow without native Appraisals, Payroll, Salary Adjustment, GRC, or disciplinary integration.
                    </div>
                    <div class="mb-2">
                        <button name="%(action_employee_performance_evaluation_create_from_employee)d"
                            type="action"
                            string="New Evaluation"
                            class="btn btn-primary"
                            context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_max_score': 60, 'default_x_grade': 'not_scored', 'default_x_star_rating': '0', 'default_x_responsible_user_id': uid}"/>
                    </div>
                    <field name="x_performance_evaluation_ids"
                        nolabel="1"
                        context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_max_score': 60, 'default_x_grade': 'not_scored', 'default_x_star_rating': '0', 'default_x_responsible_user_id': uid}">
                        <list create="0">
                            <field name="x_state"
                                widget="badge"
                                decoration-muted="x_state in ('draft', 'superseded')"
                                decoration-info="x_state == 'generated'"
                                decoration-warning="x_state == 'signature_requested'"
                                decoration-success="x_state == 'signed'"
                                decoration-danger="x_state == 'cancelled'"/>
                            <field name="x_period_date_from"/>
                            <field name="x_period_date_to"/>
                            <field name="x_total_score"/>
                            <field name="x_max_score"/>
                            <field name="x_score_percentage"/>
                            <field name="x_grade"
                                widget="badge"
                                decoration-muted="x_grade == 'not_scored'"
                                decoration-info="x_grade in ('good', 'very_good')"
                                decoration-success="x_grade == 'excellent'"
                                decoration-warning="x_grade == 'acceptable'"/>
                            <field name="x_document_reference"/>
                            <field name="x_direct_manager_employee_id" optional="show"/>
                            <field name="x_hr_user_id" optional="show"/>
                            <field name="x_responsible_user_id" optional="show"/>
                        </list>
                        <form>
                            <header>
                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="draft,generated,signature_requested,signed"
                                    readonly="1"/>
                            </header>
                            <sheet>
                                <div class="alert alert-info" role="alert">
                                    Performance evaluations cover F-0018. Scoring, PDF generation, and the three-role Odoo Sign lifecycle are handled on this evaluation record.
                                </div>

                                <!-- MCEP performance evaluation unified controls start -->

                                <div class="mcep-performance-evaluation-controls" style="width: 100%; margin: 12px 0 18px 0;">

                                    <div class="o_horizontal_separator">Workflow and Artifacts</div>

                                    <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-top: 8px;">

                                        <button name="%(action_employee_performance_evaluation_generate_pdf)d"

                                            type="action"

                                            string="Generate PDF"

                                            class="btn btn-primary"

                                            invisible="x_state in ('signature_requested', 'signed')"/>
                                        <button name="%(action_employee_performance_evaluation_send_sign)d"
                                            type="action"
                                            string="Send to Sign"
                                            class="btn btn-secondary"
                                            invisible="x_state != 'generated' or x_sign_request_res_id"/>
                                        <button name="%(action_employee_performance_evaluation_sync_sign)d"
                                            type="action"
                                            string="Sync"
                                            class="btn btn-secondary"
                                            invisible="not x_sign_request_res_id"/>

                                        <button type="action"

                                            name="%(action_employee_performance_evaluation_download_generated_pdf)d"

                                            string="Generated PDF"

                                            icon="fa-download"

                                            class="btn btn-secondary"

                                            invisible="not x_pdf_attachment_id"/>

                                        <button type="action"

                                            name="%(action_employee_performance_evaluation_download_signed_pdf)d"

                                            string="Signed PDF"

                                            icon="fa-file-pdf-o"

                                            class="btn btn-secondary"

                                            invisible="not x_signed_attachment_id"/>

                                        <button type="action"

                                            name="%(action_employee_performance_evaluation_download_sign_certificate)d"

                                            string="Certificate"

                                            icon="fa-certificate"

                                            class="btn btn-secondary"

                                            invisible="not x_sign_certificate_attachment_id"/>

                                    </div>

                                </div>

                                <!-- MCEP performance evaluation unified controls end -->
                                <group>
                                    <field name="x_employee_id" readonly="1" force_save="1"/>
                                    <field name="x_name" readonly="1"/>
                                    <field name="x_reference_code" readonly="1"/>
                                    <field name="x_document_reference" readonly="1"/>
                                </group>
                                <group string="Evaluation Period">
                                    <field name="x_period_date_from"/>
                                    <field name="x_period_date_to"/>
                                </group>
                                <group string="Evaluation Result">
                                    <field name="x_total_score" readonly="1"/>
                                    <field name="x_max_score" readonly="1"/>
                                    <field name="x_score_percentage" readonly="1"/>
                                    <field name="x_grade" readonly="1"/>
                                    <field name="x_star_rating" widget="priority" readonly="1"/>
                                </group>
                                <group string="Evaluation Items" col="1" colspan="2">
                        <field name="x_line_ids" nolabel="1" readonly="x_state != 'draft'">
                            <list editable="bottom" create="false" delete="false" default_order="x_sequence asc">
                                <field name="x_sequence" string="#" readonly="1" width="48px"/>
                                <field name="x_item_label_ar" string="Evaluation Item" readonly="1" width="72%"/>
                                <field name="x_score"
                                    string="Score"
                                    width="90px"
                                    options="{'type': 'number', 'min': 1, 'max': 5}"/>
                                <field name="x_notes" optional="hide" width="160px"/>
                            </list>
                            <form string="Performance Evaluation Item">
                                <group>
                                    <field name="x_sequence" readonly="1"/>
                                    <field name="x_item_code" readonly="1"/>
                                    <field name="x_item_label_ar" readonly="1"/>
                                    <field name="x_item_label_en" readonly="1"/>
                                    <field name="x_score"
                                        options="{'type': 'number', 'min': 1, 'max': 5}"/>
                                    <field name="x_notes"/>
                                </group>
                            </form>
                        </field>
                    </group>
                                <group string="Recommendations">
                                    <field name="x_direct_manager_recommendation"/>
                                    <field name="x_hr_manager_recommendation"/>
                                </group>
                                <group string="Approval Metadata">
                                    <field name="x_direct_manager_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_direct_manager_user_id" invisible="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Lifecycle Artifacts" invisible="1">
                                    <field name="x_pdf_attachment_id" readonly="1"/>
                                    <field name="x_signed_attachment_id" readonly="1"/>
                                    <field name="x_sign_certificate_attachment_id" readonly="1"/>
                                    <field name="x_sign_request_res_id" readonly="1"/>
                                    <field name="x_sign_request_state" readonly="1"/>
                                    <field name="x_sign_request_reference" readonly="1"/>
                                    <field name="x_sign_request_url" readonly="1"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_sent_on" readonly="1"/>
                                    <field name="x_signed_on" readonly="1"/>
                                </group>
                                <group string="Manual Decision">
                                    <field name="x_manual_decision_number"/>
                                    <field name="x_manual_decision_date"/>
                                    <field name="x_manual_decision_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Notes">
                                    <field name="x_notes"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
