<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_inherit_hr_recruitment_custom" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.hr.recruitment.custom</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Job Description">
                    <group>
                        <field name="x_baseline_functional_area_id" />
                        <field name="x_baseline_function_ids" widget="many2many_tags" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_applicant_form_inherit_hr_recruitment_custom" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.hr.recruitment.custom</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button type="action"
                    name="hr_recruitment_custom.action_hr_applicant_conduct_interview"
                    string="Conduct Interview"
                    class="btn-secondary"
                    invisible="not id" />
                <button type="action"
                    name="hr_recruitment_custom.action_hr_applicant_generate_tor_pdf"
                    string="Generate TOR PDF"
                    class="btn-primary"
                    invisible="not id" />
                <button type="action"
                    name="hr_recruitment_custom.action_hr_applicant_send_tor_for_signature"
                    string="Send TOR for Signature"
                    invisible="not id or not x_tor_pdf_attachment_id or x_tor_state != 'generated'" />
            </xpath>

            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button type="action"
                    name="hr_recruitment_custom.action_hr_recruitment_document_for_applicant"
                    class="oe_stat_button"
                    icon="fa-files-o"
                    invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Recruitment</span>
                        <span class="o_stat_text">Documents</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_phone']" position="after">
                <field name="x_gender" />
                <field name="x_national_id" />
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Evaluation">
                     <field name="x_mcep_interview_ids" context="{'default_x_applicant_id': id}">
                        <list create="false" delete="false">
                            <field name="x_name" />
                            <field name="x_interviewer_user_id" />
                            <field name="x_interview_datetime" />
                            <field name="x_total_score" />
                            <field name="x_percent_score" />
                            <field name="x_final_grade" />
                            <field name="x_visual_star_rating" widget="priority" readonly="1" />
                            <field name="x_document_state" />
                            <field name="x_recommend_for_employment" />
                        </list>
                        <form string="Interview Evaluation">
                            <header>
                                <button type="action"
                                    name="hr_recruitment_custom.action_mcep_interview_generate_pdf_tor"
                                    string="Generate Interview PDF"
                                    class="btn-primary"
                                    invisible="not id or not x_ready_for_pdf" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_mcep_interview_send_for_signature"
                                    string="Send Interview for Signature"
                                    class="btn-secondary"
                                    invisible="not id or not x_pdf_attachment_id or x_document_state != 'generated'" />
                            </header>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="x_name" readonly="1" />
                                        <field name="x_applicant_id" readonly="1" />
                                        <field name="x_interviewer_user_id" />
                                        <field name="x_interview_datetime" />
                                        <field name="x_document_state" widget="statusbar"
                                            options="{'clickable': false}"
                                            statusbar_visible="draft,generated,sent,signed"
                                            readonly="1" />
                                    </group>
                                    <group>
                                        <field name="x_total_score" readonly="1" />
                                        <field name="x_max_score" readonly="1" />
                                        <field name="x_percent_score" readonly="1" />
                                        <field name="x_final_grade" readonly="1" />
                                        <field name="x_visual_star_rating" widget="priority"
                                            readonly="1" />
                                        <field name="x_ready_for_pdf" readonly="1" />
                                        <field name="x_document_reference" readonly="1" />
                                    </group>
                                </group>
                                <group string="Interview Snapshot">
                                    <group>
                                        <field name="x_full_name_snapshot" readonly="1" />
                                        <field name="x_gender_snapshot" />
                                        <field name="x_national_id_snapshot" />
                                    </group>
                                    <group>
                                        <field name="x_employee_number_snapshot" />
                                        <field name="x_position_applied_snapshot" />
                                    </group>
                                </group>
                                <group string="Interview Document">
                                    <group>
                                        <field name="x_generated_on" readonly="1" />
                                        <field name="x_sent_on" readonly="1" />
                                        <field name="x_signed_on" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="x_pdf_attachment_id" readonly="1"
                                            domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]" />
                                        <field name="x_signed_attachment_id" readonly="1"
                                            domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]"
                                            context="{'default_res_model': 'hr.applicant', 'default_res_id': x_applicant_id}" />
                                    </group>
                                </group>
                                <group string="Evaluation Inputs">
                                    <group>
                                        <field name="x_career_aspirations" />
                                        <field name="x_long_term_employment_expected" />
                                        <field name="x_recommend_for_employment" />
                                    </group>
                                    <group>
                                        <field name="x_remarks" />
                                    </group>
                                </group>
                                <field name="x_line_ids">
                                    <list editable="bottom" create="false" delete="false">
                                        <field name="x_sequence" widget="handle" />
                                        <field name="x_question_label_ar" readonly="1" />
                                        <field name="x_actual_score"
                                            options="{'type': 'number', 'min': 1, 'max': 5}" />
                                        <field name="x_note" />
                                    </list>
                                    <form string="Interview Question">
                                        <group>
                                            <field name="x_sequence" />
                                            <field name="x_question_label_ar" readonly="1" />
                                            <field name="x_actual_score"
                                                options="{'type': 'number', 'min': 1, 'max': 5}" />
                                            <field name="x_note" />
                                        </group>
                                    </form>
                                </field>
                            </sheet>
                            <footer>
                                <button string="Save" special="save" class="btn-primary" />
                                <button string="Discard" special="cancel" class="btn-secondary" />
                            </footer>
                        </form>
                    </field>
                </page>
                <page string="Role and Duties">
                    <group>
                        <group>
                            <field name="x_tor_state" widget="statusbar"
                                options="{'clickable': false}"
                                statusbar_visible="draft,generated,sent,signed,superseded"
                                readonly="1" />
                            <field name="x_tor_recipient_name" />
                            <field name="x_tor_employee_id" />
                            <field name="x_tor_department_name" />
                            <field name="x_tor_job_title" />
                            <field name="x_tor_direct_supervisor_name" />
                            <field name="x_tor_date_of_receipt" />
                        </group>
                        <group>
                            <field name="x_tor_department_id" />
                            <field name="x_tor_version_label" readonly="1" />
                            <field name="x_tor_document_reference" readonly="1" />
                            <field name="x_tor_generated_on" readonly="1" />
                            <field name="x_tor_sent_on" readonly="1" />
                            <field name="x_tor_signed_on" readonly="1" />
                            <field name="x_tor_pdf_attachment_id" readonly="1"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', id)]" />
                            <field name="x_tor_signed_attachment_id"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', id)]"
                                context="{'default_res_model': 'hr.applicant', 'default_res_id': id}" />
                        </group>
                    </group>
                    <group>
                        <field name="x_tor_notes"
                            placeholder="Recruiter notes about this TOR version or signing workflow." />
                    </group>
                    <div class="text-muted">
                        Upload the signed TOR PDF to the applicant Files/Chatter first, then select
                        it in the Signed TOR PDF field to mark the TOR as signed.
                    </div>

                    <separator string="Negotiated Duties" />
                    <field name="x_role_and_duty_line_ids" context="{'default_x_applicant_id': id}">
                        <list editable="bottom">
                            <field name="x_sequence" widget="handle" />
                            <field name="x_functional_area_id" />
                            <field name="x_function_id"
                                domain="[('x_functional_area_id', '=', x_functional_area_id)]" />
                        </list>
                        <form string="Applicant Function Line">
                            <group>
                                <field name="x_functional_area_id" />
                                <field name="x_function_id"
                                    domain="[('x_functional_area_id', '=', x_functional_area_id)]" />
                                <field name="x_sequence" />
                            </group>
                        </form>
                    </field>
                </page>
                <page string="Documents">
                    <group>
                        <button type="action"
                            name="hr_recruitment_custom.action_hr_applicant_prepare_required_document_checklist"
                            string="Prepare Checklist"
                            class="btn-primary"
                            invisible="not id" />
                        <div class="text-muted">
                            Prepare and review the equired documents checklist here.
                            Generate the Checklist PDF, send it through Odoo Sign, then sync the signed result once the signer completes the request.
                        </div>
                    </group>

                    <field name="x_required_document_checklist_ids"
                        context="{'default_x_applicant_id': id}">
                        <list string="Required Document Checklists" create="false" delete="false">
                            <field name="x_checklist_sequence" string="#" readonly="1" />
                            <field name="x_document_reference" string="Reference" readonly="1" />
                            <field name="x_state" string="Status" readonly="1" widget="badge"
                                decoration-info="x_state in ('draft', 'in_review')"
                                decoration-warning="x_state in ('ready_for_pdf', 'signature_requested')"
                                decoration-success="x_state in ('generated', 'signed')" />
                            <field name="x_prepared_on" readonly="1" />
                            <field name="x_reviewer_user_id" string="Reviewed By" readonly="1" />
                            <field name="x_generated_on" readonly="1" />
                            <field name="x_signed_on" readonly="1" />
                        </list>
                        <form string="Required Documents Checklist">
                            <header>
                                <button type="action"
                                    name="hr_recruitment_custom.action_required_document_checklist_refresh_readiness"
                                    string="Revalidate"
                                    class="btn-primary"
                                    invisible="not id" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_required_document_checklist_generate_pdf"
                                    string="Generate F-0003 PDF"
                                    class="btn-secondary"
                                    invisible="x_state != 'ready_for_pdf' and x_state != 'generated'" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_required_document_checklist_send_native_sign"
                                    string="Send via Odoo Sign"
                                    class="btn-primary"
                                    invisible="x_state != 'generated' or not x_pdf_attachment_id" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_required_document_checklist_sync_native_sign_completion"
                                    string="Sync Signed Result"
                                    class="btn-secondary"
                                    invisible="x_state != 'signature_requested'" />
                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="draft,in_review,ready_for_pdf,generated,signature_requested,signed"
                                    readonly="1" />
                            </header>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="x_name" readonly="1" />
                                        <field name="x_applicant_id" readonly="1" />
                                        <field name="x_checklist_sequence" readonly="1" />
                                        <field name="x_document_reference" readonly="1" />
                                        <field name="x_prepared_by_user_id" readonly="1" />
                                        <field name="x_prepared_on" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="x_reviewer_user_id" string="Reviewed By" readonly="1" />
                                        <field name="x_generated_on" readonly="1" />
                                        <field name="x_sent_on" readonly="1" />
                                        <field name="x_signed_on" readonly="1" />

                                        <div class="o_row">
                                            <field name="x_pdf_attachment_id" string="Draft PDF" readonly="1"
                                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]" />
                                            <button type="action"
                                                name="hr_recruitment_custom.action_required_document_checklist_download_generated_pdf"
                                                string=""
                                                title="Download Draft PDF"
                                                icon="fa-download"
                                                class="btn-link"
                                                invisible="not x_pdf_attachment_id" />
                                        </div>

                                        <div class="o_row">
                                            <field name="x_signed_attachment_id" string="Signed PDF" readonly="1"
                                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]"
                                                context="{'default_res_model': 'hr.applicant', 'default_res_id': x_applicant_id}" />
                                            <button type="action"
                                                name="hr_recruitment_custom.action_required_document_checklist_download_signed_pdf"
                                                string=""
                                                title="Download Signed PDF"
                                                icon="fa-download"
                                                class="btn-link"
                                                invisible="not x_signed_attachment_id" />
                                        </div>
                                    </group>
                                </group>
                                <div class="alert alert-info" role="alert">
                                    Save checklist line changes before validating readiness. The
                                    checklist becomes Ready for PDF only when all required lines are
                                    Accepted.
                                </div>
                                <separator string="Required Document Lines" />
                                <field name="x_line_ids">
                                    <list editable="bottom" create="false" delete="false">
                                        <field name="x_sequence" widget="handle" />
                                        <button type="action"
                                            name="hr_recruitment_custom.action_required_document_line_create_manual_submission"
                                            string=""
                                            title="Create manual submission"
                                            icon="fa-upload"
                                            class="btn-link" />
                                        <button type="action"
                                            name="hr_recruitment_custom.action_required_document_line_open_latest_submission"
                                            string=""
                                            title="Open latest submission"
                                            icon="fa-external-link"
                                            class="btn-link" />
                                        <field name="x_document_name_ar" string="Name (AR)" readonly="1" />
                                        <field name="x_document_name_en" string="Name (EN)" readonly="1" />
                                        <field name="x_required" readonly="1" />
                                        <field name="x_status" string="Status" readonly="1" widget="badge"
                                            decoration-warning="x_status in ('missing', 'submitted', 'resubmission_requested')"
                                            decoration-success="x_status == 'accepted'"
                                            decoration-danger="x_status == 'rejected'"
                                            decoration-muted="x_status == 'not_applicable'" />
                                        <field name="x_reviewed_by_user_id" string="Reviewed By" readonly="1" />
                                    </list>
                                    <form string="Required Document Line">
                                        <group>
                                            <group>
                                                <field name="x_sequence" />
                                                <field name="x_document_type_id" readonly="1" />
                                                <field name="x_document_name_ar" readonly="1" />
                                                <field name="x_document_name_en" readonly="1" />
                                                <field name="x_document_code" readonly="1" />
                                                <field name="x_fillout_prefix" readonly="1" />
                                                <field name="x_required" />
                                                <field name="x_status" />
                                                <field name="x_capture_scope" readonly="1" />
                                                <field name="x_public_request_enabled" readonly="1" />
                                                <field name="x_requires_attachment" readonly="1" />
                                                <field name="x_manual_review_expected" readonly="1" />
                                                <field name="x_structured_data_required" readonly="1" />
                                            </group>
                                            <group>
                                                <field name="x_latest_accepted_submission_id" readonly="1" />
                                                <field name="x_latest_accepted_attachment_id"
                                                    readonly="1"
                                                    options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" />
                                                <button type="action"
                                                    name="hr_recruitment_custom.action_required_document_line_download_latest_accepted_attachment"
                                                    string="Download Accepted Evidence"
                                                    icon="fa-download"
                                                    class="btn-link"
                                                    invisible="not x_latest_accepted_attachment_id" />
                                                <field name="x_document_number" readonly="1" />
                                                <field name="x_issuing_authority" readonly="1" />
                                                <field name="x_place_of_issue" readonly="1" />
                                                <field name="x_issue_date" readonly="1" />
                                                <field name="x_expiry_date" readonly="1" />
                                                <field name="x_reviewed_by_user_id" readonly="1" />
                                                <field name="x_reviewed_on" readonly="1" />
                                            </group>
                                        </group>
                                        <field name="x_notes"
                                            placeholder="Reviewer notes, rejection reason, or structured capture notes." />
                                    </form>
                                </field>
                            </sheet>
                        </form>
                    </field>
                </page>

                <page string="Submissions">
                    <group>
                        <button type="action"
                            name="hr_recruitment_custom.action_hr_applicant_normalize_required_document_identities"
                            string="Normalize"
                            icon="fa-refresh"
                            class="btn-secondary"
                            invisible="not id" />
                        <button type="action"
                            name="hr_recruitment_custom.action_hr_applicant_create_required_document_submission_request"
                            string="Request Submission"
                            icon="fa-link"
                            class="btn-primary"
                            invisible="not id" />
                    </group>

                    <separator string="Submission Requests" />
                    <field name="x_required_document_submission_request_ids"
                        context="{'default_x_applicant_id': id}">
                        <list string="Submission Requests" create="false" delete="false">
                            <field name="x_sequence" string="#" readonly="1" />
                            <field name="x_request_reference" string="Reference" readonly="1" />
                            <field name="x_checklist_id" string="Checklist" readonly="1"
                                options="{'no_open': True}" />
                            <field name="x_state" string="Status" readonly="1" widget="badge"
                                decoration-muted="x_state in ('draft', 'cancelled')"
                                decoration-info="x_state == 'prepared'"
                                decoration-warning="x_state in ('sent', 'expired')"
                                decoration-success="x_state == 'completed'" />
                            <field name="x_candidate_email_snapshot" string="Email" readonly="1" />
                            <field name="x_expires_at" readonly="1" />
                            <field name="x_sent_on" readonly="1" />
                            <field name="x_last_response_at" readonly="1" />
                        </list>
                    </field>

                    <separator string="Submitted Evidence" />

                    <field name="x_required_document_submission_ids"
                        context="{
                            'default_x_applicant_id': id,
                            'default_x_source': 'manual',
                            'default_x_state': 'submitted',
                            'default_x_submitted_by_user_id': uid
                        }">

                        <list string="Required Document Submissions" create="false" delete="false">
                            <field name="x_submission_sequence" string="#" readonly="1" />
                            <field name="x_document_type_id" string="Type" readonly="1"
                                options="{'no_open': True}" />
                            <field name="x_state" string="Status" readonly="1" widget="badge"
                                decoration-warning="x_state == 'submitted'"
                                decoration-success="x_state == 'accepted'"
                                decoration-danger="x_state == 'rejected'"
                                decoration-muted="x_state == 'superseded'" />
                            <field name="x_checklist_id" string="Checklist" readonly="1"
                                options="{'no_open': True}" />
                            <field name="create_date" string="Created On" readonly="1" />
                            <field name="x_reviewed_on" readonly="1" />
                        </list>

                        <form string="Required Document Submission">
                            <header>
                                <button type="action"
                                    name="hr_recruitment_custom.action_required_document_submission_accept"
                                    string="Accept Submission"
                                    class="btn-primary"
                                    invisible="x_state != 'submitted'" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_required_document_submission_reject"
                                    string="Reject Submission"
                                    class="btn-secondary"
                                    invisible="x_state != 'submitted'" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_required_document_submission_download_submitted_attachment"
                                    string="Download Evidence"
                                    icon="fa-download"
                                    class="btn-secondary"
                                    invisible="not x_attachment_id" />
                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="submitted,accepted,rejected,superseded"
                                    readonly="1" />
                            </header>
                            <sheet>
                                <group>
                                    <group string="Submission Identity">
                                        <field name="x_submission_sequence" string="No." readonly="1" />
                                        <field name="x_document_code" string="Code" readonly="1" />
                                        <field name="x_applicant_id" readonly="1" />
                                        <field name="x_source" string="Source" readonly="1" />
                                        <field name="x_source_submission_id" string="Source Submission ID" readonly="1" />
                                        <field name="x_source_reference" string="Source Reference" readonly="1" />
                                    </group>

                                    <group string="Checklist Linkage">
                                        <field name="x_checklist_id" string="Checklist" readonly="1"
                                            options="{'no_open': True}" />
                                        <field name="x_line_id" string="Checklist Line" readonly="1"
                                            options="{'no_open': True}" />
                                        <field name="x_document_type_id" string="Type" readonly="1"
                                            options="{'no_open': True}" />
                                    </group>
                                </group>

                                <group string="Submitted Evidence">
                                    <group>
                                        <div class="o_row">
                                            <field name="x_attachment_id" string="Evidence"
                                                readonly="x_state != 'submitted'"
                                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]"
                                                context="{'default_res_model': 'hr.applicant', 'default_res_id': x_applicant_id}" />
                                            <button type="action"
                                                name="hr_recruitment_custom.action_required_document_submission_download_submitted_attachment"
                                                string=""
                                                title="Download Evidence"
                                                icon="fa-download"
                                                class="btn-link"
                                                invisible="not x_attachment_id" />
                                        </div>
                                        <field name="x_submitted_by_user_id"
                                            readonly="x_state != 'submitted'" />
                                        <field name="create_date" string="Created On" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="x_document_number"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_issuing_authority"
                                            readonly="x_state != 'submitted'"
                                            placeholder="Issuing authority as written on the submitted document." />
                                        <field name="x_place_of_issue"
                                            readonly="x_state != 'submitted'"
                                            placeholder="Place of issue as written on the submitted document." />
                                        <field name="x_issue_date"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_expiry_date"
                                            readonly="x_state != 'submitted'" />
                                    </group>
                                </group>

                                <group string="Structured Data"
                                    invisible="x_document_code not in ('qualification', 'birth_certificate', 'family_status', 'health_certificate', 'bank_information')">
                                    <group string="Qualification"
                                        invisible="x_document_code != 'qualification'">
                                        <field name="x_qualification_type"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_qualification_subject"
                                            readonly="x_state != 'submitted'" />
                                    </group>
                                    <group string="Birth Certificate"
                                        invisible="x_document_code != 'birth_certificate'">
                                        <field name="x_date_of_birth"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_place_of_birth"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_country_of_birth_id"
                                            readonly="x_state != 'submitted'"
                                            options="{'no_create': True, 'no_create_edit': True}" />
                                    </group>
                                    <group string="Family / Next of Kin"
                                        invisible="x_document_code != 'family_status'">
                                        <field name="x_family_paper_number"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_family_reference_number"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_next_of_kin_name"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_next_of_kin_phone"
                                            readonly="x_state != 'submitted'" />
                                    </group>
                                    <group string="Health"
                                        invisible="x_document_code != 'health_certificate'">
                                        <field name="x_blood_type"
                                            readonly="x_state != 'submitted'" />
                                    </group>
                                    <group string="Bank Information"
                                        invisible="x_document_code != 'bank_information'">
                                        <field name="x_bank_name"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_bank_branch"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_account_number"
                                            readonly="x_state != 'submitted'" />
                                        <field name="x_iban"
                                            readonly="x_state != 'submitted'" />
                                    </group>
                                </group>

                                <group string="Review">
                                    <group>
                                        <field name="x_reviewed_by_user_id" readonly="1" />
                                        <field name="x_reviewed_on" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="x_reviewer_note"
                                            placeholder="Reviewer note or rejection reason. Required before rejecting a submission." />
                                    </group>
                                </group>

                                <group string="Notes">
                                    <field name="x_notes"
                                        placeholder="Internal notes about this submitted evidence." />
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>             

                <page string="Declarations">
                    <group>
                        <div class="text-muted">
                            F-0004, F-0007, and F-0009 declaration generation and signature
                            workflows
                            will be implemented in later passes.
                        </div>
                    </group>
                </page>
                
                <page string="Contract">
                    <group>
                        <div class="text-muted">
                            Board decision, official labor contract artifact tracking,
                            contract-support
                            fields, employee ID generation, and handover readiness will be
                            implemented
                            in later passes.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_mcep_interview_form" model="ir.ui.view">
        <field name="name">x.hr.applicant.mcep.interview.form</field>
        <field name="model">x_hr.applicant_mcep_interview</field>
        <field name="arch" type="xml">
            <form string="Interview Evaluation">
                <header>
                    <button type="action"
                        name="hr_recruitment_custom.action_mcep_interview_generate_pdf_tor"
                        string="Generate Interview PDF"
                        class="btn-primary"
                        invisible="not id or not x_ready_for_pdf" />
                    <button type="action"
                        name="hr_recruitment_custom.action_mcep_interview_send_for_signature"
                        string="Send Interview for Signature"
                        class="btn-secondary"
                        invisible="not id or not x_pdf_attachment_id or x_document_state != 'generated'" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name" readonly="1" />
                            <field name="x_applicant_id" readonly="1" />
                            <field name="x_interviewer_user_id" />
                            <field name="x_interview_datetime" />
                            <field name="x_document_state" widget="statusbar"
                                options="{'clickable': false}"
                                statusbar_visible="draft,generated,sent,signed" readonly="1" />
                        </group>
                        <group>
                            <field name="x_total_score" readonly="1" />
                            <field name="x_max_score" readonly="1" />
                            <field name="x_percent_score" readonly="1" />
                            <field name="x_final_grade" readonly="1" />
                            <field name="x_visual_star_rating" widget="priority" readonly="1" />
                            <field name="x_ready_for_pdf" readonly="1" />
                            <field name="x_document_reference" readonly="1" />
                        </group>
                    </group>
                    <group string="Interview Snapshot">
                        <group>
                            <field name="x_full_name_snapshot" readonly="1" />
                            <field name="x_gender_snapshot" />
                            <field name="x_national_id_snapshot" />
                        </group>
                        <group>
                            <field name="x_employee_number_snapshot" />
                            <field name="x_position_applied_snapshot" />
                        </group>
                    </group>
                    <group string="Interview Document">
                        <group>
                            <field name="x_generated_on" readonly="1" />
                            <field name="x_sent_on" readonly="1" />
                            <field name="x_signed_on" readonly="1" />
                        </group>
                        <group>
                            <field name="x_pdf_attachment_id" readonly="1"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]" />
                            <field name="x_signed_attachment_id"
                                readonly="x_document_state == 'signed'"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                domain="[('res_model', '=', 'hr.applicant'), ('res_id', '=', x_applicant_id)]"
                                context="{'default_res_model': 'hr.applicant', 'default_res_id': x_applicant_id}" />
                        </group>
                    </group>
                    <group string="Evaluation Inputs">
                        <group>
                            <field name="x_career_aspirations" />
                            <field name="x_long_term_employment_expected" />
                            <field name="x_recommend_for_employment" />
                        </group>
                        <group>
                            <field name="x_remarks" />
                        </group>
                    </group>
                    <field name="x_line_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="x_sequence" widget="handle" />
                            <field name="x_question_label_ar" readonly="1" />
                            <field name="x_actual_score"
                                options="{'type': 'number', 'min': 1, 'max': 5}" />
                            <field name="x_note" />
                        </list>
                        <form string="Interview Question">
                            <group>
                                <field name="x_sequence" />
                                <field name="x_question_label_ar" readonly="1" />
                                <field name="x_actual_score"
                                    options="{'type': 'number', 'min': 1, 'max': 5}" />
                                <field name="x_note" />
                            </group>
                        </form>
                    </field>
                    <chatter />
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary" />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_mcep_interview_list" model="ir.ui.view">
        <field name="name">x.hr.applicant.mcep.interview.list</field>
        <field name="model">x_hr.applicant_mcep_interview</field>
        <field name="arch" type="xml">
            <list string="Interview Evaluations">
                <field name="x_name" />
                <field name="x_applicant_id" />
                <field name="x_interviewer_user_id" />
                <field name="x_interview_datetime" />
                <field name="x_total_score" />
                <field name="x_percent_score" />
                <field name="x_final_grade" />
                <field name="x_visual_star_rating" widget="priority" readonly="1" />
                <field name="x_document_state" />
                <field name="x_recommend_for_employment" />
            </list>
        </field>
    </record>

    <record id="view_mcep_interview_question_list" model="ir.ui.view">
        <field name="name">x.mcep.interview.question.list</field>
        <field name="model">x_mcep.interview_question</field>
        <field name="arch" type="xml">
            <list string="Interview Questions">
                <field name="x_sequence" />
                <field name="x_name" />
                <field name="x_default_max_score" />
                <field name="x_active" />
            </list>
        </field>
    </record>
</odoo>