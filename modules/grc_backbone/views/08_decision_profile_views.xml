<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_decision_profiles" name="نماذج القرارات" parent="grc_backbone.menu_decision_engine" action="grc_backbone.action_decision_profile" sequence="20"/>
    <menuitem id="menu_decision_configuration" name="الإعدادات" parent="grc_backbone.menu_decision_engine" sequence="90"/>
    <menuitem id="menu_decision_families" name="مجالات الحوكمة" parent="grc_backbone.menu_decision_configuration" action="grc_backbone.action_decision_family" sequence="10"/>
    <menuitem id="menu_decision_types" name="إجراءات الحوكمة" parent="grc_backbone.menu_decision_configuration" action="grc_backbone.action_decision_type" sequence="20"/>
    <menuitem id="menu_decision_basis_phrases" name="صيغ الأسانيد" parent="grc_backbone.menu_decision_configuration" action="grc_backbone.action_decision_basis_phrase" sequence="30"/>

    <record id="view_decision_family_list" model="ir.ui.view">
        <field name="name">x_grc.decision_family.list</field>
        <field name="model">x_grc.decision_family</field>
        <field name="arch" type="xml">
            <list string="مجالات الحوكمة">
                <field name="x_code"/>
                <field name="x_name"/>
                <field name="x_active" string="نشط"/>
            </list>
        </field>
    </record>

    <record id="view_decision_family_form" model="ir.ui.view">
        <field name="name">x_grc.decision_family.form</field>
        <field name="model">x_grc.decision_family</field>
        <field name="arch" type="xml">
            <form string="مجال الحوكمة">
                <sheet>
                    <group>
                        <field name="x_name"/>
                        <field name="x_code"/>
                        <field name="x_active" string="نشط"/>
                    </group>
                    <group>
                        <field name="x_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_decision_type_list" model="ir.ui.view">
        <field name="name">x_grc.decision_type.list</field>
        <field name="model">x_grc.decision_type</field>
        <field name="arch" type="xml">
            <list string="إجراءات الحوكمة">
                <field name="x_code"/>
                <field name="x_name"/>
                <field name="x_family_id" string="مجال الحوكمة"/>
                <field name="x_active" string="نشط"/>
            </list>
        </field>
    </record>

    <record id="view_decision_type_form" model="ir.ui.view">
        <field name="name">x_grc.decision_type.form</field>
        <field name="model">x_grc.decision_type</field>
        <field name="arch" type="xml">
            <form string="إجراء الحوكمة">
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_code"/>
                            <field name="x_family_id" string="مجال الحوكمة"/>
                            <field name="x_active" string="نشط"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_decision_profile_list" model="ir.ui.view">
        <field name="name">x_grc.decision_profile.list</field>
        <field name="model">x_grc.decision_profile</field>
        <field name="arch" type="xml">
            <list string="نماذج القرارات">
                <field name="x_code"/>
                <field name="x_name"/>
                <field name="x_family_id" string="مجال الحوكمة"/>
                <field name="x_type_id" string="إجراء الحوكمة"/>
                <field name="x_default_issuer_title_ar"/>
                <field name="x_authority_mode"/>
                <field name="x_active" string="نشط"/>
            </list>
        </field>
    </record>

    <record id="view_decision_profile_form" model="ir.ui.view">
        <field name="name">x_grc.decision_profile.form</field>
        <field name="model">x_grc.decision_profile</field>
        <field name="arch" type="xml">
            <form string="نموذج القرار">
                <sheet>
                    <group>
                        <group string="Profile Identity">
                            <field name="x_name"/>
                            <field name="x_code"/>
                            <field name="x_family_id" string="مجال الحوكمة"/>
                            <field name="x_type_id" string="إجراء الحوكمة"/>
                            <field name="x_active" string="نشط"/>
                        </group>
                        <group string="Template Defaults">
                            <field name="x_template_code_default"/>
                            <field name="x_reference_prefix"/>
                            <field name="x_default_issuer_title_ar"/>
                            <field name="x_default_issuer_title_en"/>
                            <field name="x_authority_mode"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_decision_basis_phrase_list" model="ir.ui.view">
        <field name="name">x_grc.decision_basis_phrase.list</field>
        <field name="model">x_grc.decision_basis_phrase</field>
        <field name="arch" type="xml">
            <list string="Basis Phrases" editable="bottom">
                <field name="x_sequence"/>
                <field name="x_name"/>
                <field name="x_phrase_ar"/>
                <field name="x_phrase_en"/>
                <field name="x_active" string="نشط"/>
            </list>
        </field>
    </record>

    <record id="view_decision_basis_phrase_form" model="ir.ui.view">
        <field name="name">x_grc.decision_basis_phrase.form</field>
        <field name="model">x_grc.decision_basis_phrase</field>
        <field name="arch" type="xml">
            <form string="Basis Phrase">
                <sheet>
                    <group>
                        <field name="x_sequence"/>
                        <field name="x_name"/>
                        <field name="x_phrase_ar"/>
                        <field name="x_phrase_en"/>
                        <field name="x_active" string="نشط"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
