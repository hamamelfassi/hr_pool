<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Pass 6B-4                                                 -->
    <!-- Controlled request/request-line views                      -->
    <!-- ========================================================= -->

    <record id="view_required_document_submission_request_list_controlled" model="ir.ui.view">
        <field name="name">x.hr.applicant.required.document.submission.request.list.controlled</field>
        <field name="model">x_hr.applicant_required_document_submission_request</field>
        <field name="priority" eval="5" />
        <field name="arch" type="xml">
            <list string="Required Document Submission Requests" create="false" delete="false">
                <field name="x_sequence" string="#" readonly="1" />
                <field name="x_request_reference" readonly="1" />
                <field name="x_name" readonly="1" />
                <field name="x_applicant_id" readonly="1" />
                <field name="x_checklist_id" readonly="1" />
                <field name="x_state" string="Status" readonly="1" widget="badge"
                    decoration-warning="x_state in ('requested', 'submitted')"
                    decoration-success="x_state == 'accepted'"
                    decoration-danger="x_state == 'rejected'"
                    decoration-muted="x_state == 'cancelled'" />
                <field name="x_candidate_email_snapshot" readonly="1" />
                <field name="x_expires_at" readonly="1" />
                <field name="x_sent_on" readonly="1" />
                <field name="x_last_response_at" readonly="1" />
            </list>
        </field>
    </record>

    <record id="view_required_document_submission_request_form_controlled" model="ir.ui.view">
        <field name="name">x.hr.applicant.required.document.submission.request.form.controlled</field>
        <field name="model">x_hr.applicant_required_document_submission_request</field>
        <field name="priority" eval="5" />
        <field name="arch" type="xml">
            <form string="Required Document Submission Request" create="false" delete="false">
                <header>
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_request_refresh_candidate_snapshot"
                        string="Refresh Candidate Snapshot"
                        class="btn-secondary"
                        invisible="not id or x_state not in ('draft', 'prepared')" />
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_request_generate_lines"
                        string="Generate Request Lines"
                        class="btn-primary"
                        invisible="not id or x_state not in ('draft', 'prepared')" />
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_request_generate_url"
                        string="Generate Continuation URL"
                        class="btn-secondary"
                        invisible="not id or x_state not in ('draft', 'prepared')" />
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_request_open_url"
                        string="Open URL"
                        class="btn-secondary"
                        invisible="not id or not x_generated_url" />
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_request_sync_lines_from_submissions"
                        string="Sync"
                        class="btn-secondary"
                        invisible="not id" />
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_request_send_email"
                        string="Send Request Email"
                        class="btn-primary"
                        invisible="not id or not x_generated_url or x_state not in ('draft', 'prepared')" />
                    <button type="action"
                        name="hr_recruitment_custom.action_required_document_submission_request_mark_manual_sent"
                        string="Mark Manually Sent"
                        class="btn-secondary"
                        invisible="not id or not x_generated_url or x_state not in ('draft', 'prepared')" />
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,prepared,sent,expired,completed,cancelled"
                        readonly="1" />
                </header>

                <sheet>
                    <group>
                        <group string="Request Identity">
                            <field name="x_name" string="Request" readonly="1" />
                            <field name="x_request_reference" string="Reference" readonly="1" />
                            <field name="x_sequence" string="No." readonly="1" />
                            <field name="x_applicant_id" readonly="1" />
                            <field name="x_checklist_id" readonly="1" />
                        </group>
                        <group string="Candidate / Token">
                            <field name="x_candidate_name_snapshot" string="Name" readonly="1" />
                            <field name="x_candidate_email_snapshot" string="Email" readonly="1" />
                            <field name="x_token_reference" readonly="1" />
                            <field name="x_expires_at" readonly="1" />
                        </group>
                    </group>

                    <group string="Fillout Continuation URL">
                        <field name="x_form_base_url"
                            readonly="x_state not in ('draft', 'prepared')" />
                        <field name="x_generated_url"
                            readonly="1"
                            widget="url"
                            invisible="x_state in ('completed', 'cancelled')" />
                    </group>

                    <separator string="Request Lines" />
                    <field name="x_line_ids">
                        <list create="false" delete="false">
                            <field name="x_sequence" widget="handle" />
                            <field name="x_document_code" string="Code" readonly="1" />
                            <field name="x_state" string="Status" readonly="1" widget="badge"
                                decoration-warning="x_state in ('requested', 'submitted')"
                                decoration-success="x_state == 'accepted'"
                                decoration-danger="x_state == 'rejected'"
                                decoration-muted="x_state == 'cancelled'" />
                            <field name="x_checklist_line_id" string="Checklist Line" readonly="1"
                                options="{'no_open': True}" />
                            <field name="x_requires_attachment" string="Attachment" readonly="1" />
                            <field name="x_latest_submission_id" string="Latest Submission" readonly="1"
                                options="{'no_open': True}" />
                        </list>
                        <form string="Required Document Request Line" create="false" delete="false">
                            <group>
                                <group string="Line Identity">
                                    <field name="x_name" readonly="1" />
                                    <field name="x_sequence" readonly="1" />
                                    <field name="x_state" />
                                    <field name="x_applicant_id" readonly="1" />
                                    <field name="x_checklist_id" readonly="1" />
                                    <field name="x_checklist_line_id" readonly="1" />
                                    <field name="x_document_type_id" readonly="1" />
                                </group>
                                <group string="Fillout Routing">
                                    <field name="x_document_code" readonly="1" />
                                    <field name="x_fillout_prefix" readonly="1" />
                                    <field name="x_public_request_enabled" readonly="1" />
                                    <field name="x_requires_attachment" readonly="1" />
                                    <field name="x_structured_data_required" readonly="1" />
                                    <field name="x_manual_review_expected" readonly="1" />
                                </group>
                            </group>
                            <group string="URL Parameter Names">
                                <group>
                                    <field name="x_show_param_name" readonly="1" />
                                    <field name="x_request_line_param_name" readonly="1" />
                                    <field name="x_checklist_line_param_name" readonly="1" />
                                </group>
                                <group>
                                    <field name="x_document_type_param_name" readonly="1" />
                                    <field name="x_document_code_param_name" readonly="1" />
                                </group>
                            </group>
                            <group string="Submission Linkage">
                                <field name="x_latest_submission_id" readonly="1" />
                            </group>
                            <group string="Notes">
                                <field name="x_notes" />
                            </group>
                        </form>
                    </field>

                    <group>
                        <group string="Request Audit">
                            <field name="x_requested_by_user_id" readonly="1" />
                            <field name="x_requested_on" readonly="1" />
                            <field name="x_sent_by_user_id" readonly="1" />
                            <field name="x_sent_on" readonly="1" />
                            <field name="x_last_response_at" readonly="1" />
                        </group>
                        <group string="Notes">
                            <field name="x_notes" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

</odoo>