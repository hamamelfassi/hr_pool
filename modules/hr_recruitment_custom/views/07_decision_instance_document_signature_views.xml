<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_decision_instance_form_hr_document_signature" model="ir.ui.view">
        <field name="name">x_grc.decision_instance.form.hr.document.signature</field>
        <field name="model">x_grc.decision_instance</field>
        <field name="inherit_id" ref="grc_backbone.view_decision_instance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Document and Signature" invisible="not x_hr_applicant_id">
                    <group string="Document and Signature Flow">
                        <field name="x_hr_document_state"
                            string="Document and Signature Flow"
                            widget="statusbar"
                            statusbar_visible="none,generated,sent,signed,stamped"
                            nolabel="1"
                            readonly="1"/>
                    </group>
                    <group>
                        <group string="Document Status">
                            <field name="x_hr_document_state"
                                string="Document and Signature Status"
                                widget="badge"
                                decoration-muted="not x_hr_document_state or x_hr_document_state == 'none'"
                                decoration-info="x_hr_document_state in ['generated', 'sent']"
                                decoration-success="x_hr_document_state in ['signed', 'stamped']"
                                readonly="1"/>
                            <field name="x_state" string="Decision Status" widget="badge" readonly="1"/>
                            <field name="x_hr_signer_user_id"
                                string="Authorized Signer"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_hr_sign_request_id"
                                string="Sign Request"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_hr_sign_request_state"
                                string="Sign Request Status"
                                readonly="1"/>
                        </group>

                        <group string="Recruitment Source">
                            <field name="x_hr_applicant_id"
                                string="Applicant"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_hr_job_id"
                                string="Job Position"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_hr_department_id"
                                string="Administrative Unit"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_source_model" string="Source Model" readonly="1"/>
                            <field name="x_source_res_id" string="Source Record ID" readonly="1"/>
                        </group>
                    </group>

                    <group string="Generated Document">
                        <group>
                            <field name="x_hr_generated_attachment_id"
                                string="Generated Document"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_hr_generated_on" string="Generated On" readonly="1"/>
                            <field name="x_hr_recruitment_document_id"
                                string="Recruitment Document"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="Document Actions">
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_generate_board_decision_pdf"
                                string="Generate Document"
                                icon="fa-file-pdf-o"
                                class="btn-primary"
                                invisible="x_state != 'locked' or x_hr_document_state in ['sent', 'signed', 'stamped']"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_open_generated_pdf"
                                string="Open Document"
                                icon="fa-external-link"
                                class="btn-secondary"
                                invisible="not x_hr_generated_attachment_id"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_download_generated_pdf"
                                string="Download Document"
                                icon="fa-download"
                                class="btn-secondary"
                                invisible="not x_hr_generated_attachment_id"/>
                        </group>
                    </group>

                    <group string="Signature">
                        <group>
                            <field name="x_hr_sent_on" string="Sent On" readonly="1"/>
                            <field name="x_hr_signed_on" string="Signed On" readonly="1"/>
                            <field name="x_hr_signed_attachment_id"
                                string="Signed Document"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_hr_certificate_attachment_id"
                                string="Sign Certificate"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="Signature Actions">
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_send_board_decision_sign"
                                string="Send for Signature"
                                icon="fa-pencil"
                                class="btn-primary"
                                invisible="x_state != 'locked' or x_hr_document_state != 'generated' or not x_hr_generated_attachment_id or x_hr_sign_request_id"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_sync_board_decision_sign"
                                string="Sync Signature"
                                icon="fa-refresh"
                                class="btn-secondary"
                                invisible="not x_hr_sign_request_id or x_hr_document_state in ['signed', 'stamped']"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_open_signed_pdf"
                                string="Open Signed PDF"
                                icon="fa-external-link"
                                class="btn-secondary"
                                invisible="not x_hr_signed_attachment_id"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_download_signed_pdf"
                                string="Download Signed PDF"
                                icon="fa-download"
                                class="btn-secondary"
                                invisible="not x_hr_signed_attachment_id"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_open_certificate"
                                string="Open Sign Certificate"
                                icon="fa-external-link"
                                class="btn-secondary"
                                invisible="not x_hr_certificate_attachment_id"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_download_certificate"
                                string="Download Sign Certificate"
                                icon="fa-download"
                                class="btn-secondary"
                                invisible="not x_hr_certificate_attachment_id"/>
                        </group>
                    </group>

                    <group string="Stamped Copy">
                        <group>
                            <field name="x_hr_stamped_upload"
                                string="Upload Stamped Copy"
                                filename="x_hr_stamped_filename"
                                readonly="x_hr_document_state not in ['signed', 'stamped']"/>
                            <field name="x_hr_stamped_filename" invisible="1"/>
                            <field name="x_hr_stamped_attachment_id"
                                string="Linked Stamped Copy"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_hr_stamped_on" string="Stamped Copy Uploaded On" readonly="1"/>
                        </group>
                        <group string="Stamped Copy Actions">
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_open_stamped_copy"
                                string="Open Stamped Copy"
                                icon="fa-external-link"
                                class="btn-secondary"
                                invisible="not x_hr_stamped_attachment_id"/>
                            <button type="action"
                                name="hr_recruitment_custom.action_decision_instance_download_stamped_copy"
                                string="Download Stamped Copy"
                                icon="fa-download"
                                class="btn-secondary"
                                invisible="not x_hr_stamped_attachment_id"/>
                        </group>
                    </group>

                    <group string="Recruitment Notes">
                        <field name="x_hr_notes" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
