<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Pass 7A-6H:
        Active core base fields only.
        Retired GRC scaffold fields are no longer loaded from source; existing DB columns may remain dormant.
    -->

    <record id="field_functional_area_x_name" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_functional_area" />
            <field name="name">x_name</field>
            <field name="field_description">Functional Area</field>
            <field name="ttype">char</field>
            <field name="required">True</field>
            <field name="index">True</field>
        
            <field name="translate">standard</field>
        </record>

    <record id="field_functional_area_x_code" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_functional_area" />
            <field name="name">x_code</field>
            <field name="field_description">Code</field>
            <field name="ttype">char</field>
            <field name="index">True</field>
        </record>

    <record id="field_functional_area_x_description" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_functional_area" />
            <field name="name">x_description</field>
            <field name="field_description">Description</field>
            <field name="ttype">text</field>
        
            <field name="translate">standard</field>
        </record>

    <record id="field_functional_area_x_state" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_functional_area" />
            <field name="name">x_state</field>
            <field name="field_description">State</field>
            <field name="ttype">selection</field>
            <field name="required">True</field>
        </record>

    <record id="field_function_x_name" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_function" />
            <field name="name">x_name</field>
            <field name="field_description">Function</field>
            <field name="ttype">char</field>
            <field name="required">True</field>
            <field name="index">True</field>
        
            <field name="translate">standard</field>
        </record>

    <record id="field_function_x_code" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_function" />
            <field name="name">x_code</field>
            <field name="field_description">Code</field>
            <field name="ttype">char</field>
            <field name="index">True</field>
        </record>

    <record id="field_function_x_description" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_function" />
            <field name="name">x_description</field>
            <field name="field_description">Description</field>
            <field name="ttype">text</field>
        
            <field name="translate">standard</field>
        </record>

    <record id="field_function_x_functional_area_id" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_function" />
            <field name="name">x_functional_area_id</field>
            <field name="field_description">Functional Area</field>
            <field name="ttype">many2one</field>
            <field name="relation">x_grc.functional_area</field>
            <field name="required">True</field>
            <field name="on_delete">restrict</field>
        </record>

    <record id="field_function_x_state" model="ir.model.fields">
            <field name="model_id" ref="grc_backbone.model_function" />
            <field name="name">x_state</field>
            <field name="field_description">State</field>
            <field name="ttype">selection</field>
            <field name="required">True</field>
        </record>
</odoo>
