<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Training Types                                                -->
    <!-- ============================================================= -->

    <record id="view_hr_training_list" model="ir.ui.view">
        <field name="name">x.hr.training.list</field>
        <field name="model">x_hr.training</field>
        <field name="arch" type="xml">
            <list string="Training Types">
                <field name="x_active"/>
                <field name="x_name"/>
                <field name="x_functional_area_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_training_form" model="ir.ui.view">
        <field name="name">x.hr.training.form</field>
        <field name="model">x_hr.training</field>
        <field name="arch" type="xml">
            <form string="Training Type">
                <sheet>
                    <group>
                        <field name="x_active"/>
                        <field name="x_name"/>
                        <field name="x_functional_area_id"/>
                    </group>
                    <group string="Notes">
                        <field name="x_notes" nolabel="1"/>
                    </group>
                    <group string="Courses">
                        <field name="x_training_course_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="x_active"/>
                                <field name="x_course_name"/>
                                <field name="x_training_provider_id"/>
                                <field name="x_training_start_date"/>
                                <field name="x_training_end_date"/>
                                <field name="x_participant_seats"/>
                                <field name="x_seat_cost_amount"/>
                                <field name="x_total_cost"/>
                                <field name="x_currency_label"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_training_types" model="ir.actions.act_window">
        <field name="name">Training Types</field>
        <field name="res_model">x_hr.training</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_active': True}</field>
    </record>

    <!-- ============================================================= -->
    <!-- Training Courses                                              -->
    <!-- ============================================================= -->

    <record id="view_hr_training_course_list" model="ir.ui.view">
        <field name="name">x.hr.training.course.list</field>
        <field name="model">x_hr.training_course</field>
        <field name="arch" type="xml">
            <list string="Training Courses">
                <field name="x_active"/>
                <field name="x_course_name"/>
                <field name="x_course_training_type_id"/>
                <field name="x_training_provider_id"/>
                <field name="x_training_location"/>
                <field name="x_training_start_date"/>
                <field name="x_training_end_date"/>
                <field name="x_participant_seats"/>
                <field name="x_seat_cost_amount"/>
                <field name="x_total_cost"/>
                <field name="x_currency_label"/>
                <field name="x_recovery_required_if_breached"/>
            </list>
        </field>
    </record>

    <record id="view_hr_training_course_form" model="ir.ui.view">
        <field name="name">x.hr.training.course.form</field>
        <field name="model">x_hr.training_course</field>
        <field name="arch" type="xml">
            <form string="Training Course">
                <sheet>
                    <group>
                        <field name="x_active"/>
                        <field name="x_course_name"/>
                        <field name="x_course_training_type_id"/>
                        <field name="x_function_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Provider and Schedule">
                        <field name="x_training_provider_id"/>
                        <field name="x_training_location"/>
                        <field name="x_training_start_date"/>
                        <field name="x_training_end_date"/>
                    </group>
                    <group string="Participants">
                        <field name="x_participant_seats"/>
                        <field name="x_participant_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Employee Commitments">
                        <field name="x_participant_commitment_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="x_employee_id"/>
                                <field name="x_state" widget="badge"/>
                                <field name="x_commitment_state" widget="badge"/>
                                <field name="x_participation_state" widget="badge"/>
                                <field name="x_document_reference"/>
                                <field name="x_commitment_start_date"/>
                                <field name="x_commitment_end_date"/>
                            </list>
                        </field>
                    </group>
                    <group string="Cost and Recovery">
                        <field name="x_seat_cost_amount"/>
                        <field name="x_seat_cost_amount_words"/>
                        <field name="x_total_cost"/>
                        <field name="x_currency_label"/>
                        <field name="x_recovery_required_if_breached"/>
                    </group>
                    <group string="Notes">
                        <field name="x_notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_training_courses" model="ir.actions.act_window">
        <field name="name">Training Courses</field>
        <field name="res_model">x_hr.training_course</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_active': True, 'default_x_participant_seats': 1}</field>
    </record>


    <!-- Employee Training Commitments -->

    <record id="view_employee_training_commitment_list" model="ir.ui.view">
        <field name="name">x.hr.employee.training.commitment.list</field>
        <field name="model">x_hr.employee_training_commitment</field>
        <field name="arch" type="xml">
            <list string="Employee Training Commitments">
                <field name="x_employee_id"/>
                <field name="x_training_course_id"/>
                <field name="x_state" widget="badge"/>
                <field name="x_commitment_state" widget="badge"/>
                <field name="x_participation_state" widget="badge"/>
                <field name="x_document_reference"/>
                <field name="x_commitment_start_date"/>
                <field name="x_commitment_end_date"/>
                <field name="x_recovery_amount"/>
                <field name="x_responsible_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_employee_training_commitment_form" model="ir.ui.view">
        <field name="name">x.hr.employee.training.commitment.form</field>
        <field name="model">x_hr.employee_training_commitment</field>
        <field name="arch" type="xml">
            <form string="Employee Training Commitment">
                <header>
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,generated,signature_requested,signed"
                        readonly="1"/>
                    <button type="action"
                        name="%(action_employee_training_download_generated_pdf)d"
                        string=""
                        title="Download Generated PDF"
                        icon="fa-download"
                        class="btn-link"
                        invisible="not x_pdf_attachment_id"/>
                    <button type="action"
                        name="%(action_employee_training_download_signed_pdf)d"
                        string=""
                        title="Download Signed PDF"
                        icon="fa-file-pdf-o"
                        class="btn-link"
                        invisible="not x_signed_attachment_id"/>
                    <button type="action"
                        name="%(action_employee_training_download_sign_certificate)d"
                        string=""
                        title="Download Sign Certificate"
                        icon="fa-certificate"
                        class="btn-link"
                        invisible="not x_sign_certificate_attachment_id"/>
                </header>
                <sheet>
                    <div class="mb-2">
                        <button name="%(action_employee_training_generate_f0008_pdf)d"
                            type="action"
                            string="Generate PDF"
                            class="btn btn-primary"
                            invisible="x_state in ('signature_requested', 'signed')"/>
                        <button name="%(action_employee_training_mark_breached)d"
                            type="action"
                            string="Mark Breached"
                            class="btn btn-secondary"
                            invisible="x_commitment_state in ('breached', 'fulfilled', 'cancelled')"/>
                        <button name="%(action_employee_training_mark_fulfilled)d"
                            type="action"
                            string="Mark Fulfilled"
                            class="btn btn-secondary"
                            invisible="x_commitment_state in ('fulfilled', 'cancelled')"/>
                        <button name="%(action_employee_training_mark_cancelled)d"
                            type="action"
                            string="Mark Cancelled"
                            class="btn btn-secondary"
                            invisible="x_commitment_state == 'cancelled'"/>
                        <span class="mx-1"/>
                        <button name="%(action_employee_training_set_in_training)d"
                            type="action"
                            string="Set In Training"
                            class="btn btn-secondary"
                            invisible="x_participation_state != 'allocated'"/>
                        <button name="%(action_employee_training_set_complete)d"
                            type="action"
                            string="Set Complete"
                            class="btn btn-secondary"
                            invisible="x_participation_state not in ('allocated', 'in_training')"/>
                        <button name="%(action_employee_training_set_incomplete)d"
                            type="action"
                            string="Set Incomplete"
                            class="btn btn-secondary"
                            invisible="x_participation_state not in ('allocated', 'in_training')"/>
                    </div>

                    

                                <div class="alert alert-info" role="alert">
                        Training commitments are employee-specific F-0008 process records. PDF and Sign lifecycle will be added in later Pass 17 slices.
                    </div>
                    <group>
                        <field name="x_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_training_course_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_training_type_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="x_name" readonly="1"/>
                        <field name="x_reference_code" readonly="1"/>
                        <field name="x_document_reference" readonly="1"/>
                    </group>
                    <group string="States">
                        <field name="x_state" readonly="1"/>
                        <field name="x_commitment_state" readonly="1"/>
                        <field name="x_is_breached"/>
                        <field name="x_participation_state" readonly="1"/>
                    </group>
                    <group string="Commitment and Recovery">
                        <field name="x_service_commitment_months"/>
                        <field name="x_commitment_start_date"/>
                        <field name="x_commitment_end_date" readonly="1"/>
                        <field name="x_recovery_amount" readonly="1"/>
                        <field name="x_recovery_amount_words" readonly="1"/>
                        <field name="x_recovery_required_if_breached" readonly="1"/>
                        <field name="x_recovery_notes"/>
                    </group>
                    <group string="Artifacts">
                        <field name="x_pdf_attachment_id" readonly="1"/>
                        <field name="x_signed_attachment_id" readonly="1"/>
                        <field name="x_sign_certificate_attachment_id" readonly="1"/>
                        <field name="x_generated_on" readonly="1"/>
                        <field name="x_sent_on" readonly="1"/>
                        <field name="x_signed_on" readonly="1"/>
                    </group>
                    <group string="Odoo Sign">
                        <field name="x_sign_request_res_id" readonly="1"/>
                        <field name="x_sign_request_state" readonly="1"/>
                        <field name="x_sign_request_reference" readonly="1"/>
                        <field name="x_sign_request_url" readonly="1"/>
                    </group>
                    <group string="Manual Decision">
                        <field name="x_manual_decision_number"/>
                        <field name="x_manual_decision_date"/>
                        <field name="x_manual_decision_attachment_id"/>
                    </group>
                    <group string="Ownership and Notes">
                        <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_training_commitments" model="ir.actions.act_window">
        <field name="name">Employee Training Commitments</field>
        <field name="res_model">x_hr.employee_training_commitment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_employee_training_commitment_create" model="ir.actions.act_window">
        <field name="name">New Training</field>
        <field name="res_model">x_hr.employee_training_commitment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_training_commitment_form"/>
        <field name="target">new</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_commitment_state': 'applied', 'default_x_participation_state': 'allocated', 'default_x_service_commitment_months': 24}</field>
    </record>

    <record id="view_hr_employee_form_inherit_employee_training" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.training</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mcep_employee_training_certifications" string="Training">
                    

                                <div class="alert alert-info" role="alert">
                        Training commitments record employee participation in approved training courses and prepare the F-0008 undertaking lifecycle.
                    </div>
                    <div class="mb-2">
                        <button name="%(action_employee_training_commitment_create)d" type="action" string="New Training" class="btn btn-primary" context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_commitment_state': 'applied', 'default_x_participation_state': 'allocated', 'default_x_service_commitment_months': 24, 'default_x_responsible_user_id': uid}"/>
                    </div>
                                        <field name="x_training_commitment_ids"
                        nolabel="1"
                        context="{'default_x_employee_id': id}">
                        <list create="0">
                            <field name="x_training_course_id"/>
                            <field name="x_state"
                                widget="badge"
                                decoration-muted="x_state == 'draft'"
                                decoration-info="x_state == 'generated'"
                                decoration-warning="x_state == 'signature_requested'"
                                decoration-success="x_state == 'signed'"/>
                            <field name="x_commitment_state"
                                widget="badge"
                                decoration-muted="x_commitment_state == 'applied'"
                                decoration-info="x_commitment_state == 'committed'"
                                decoration-warning="x_commitment_state == 'breached'"
                                decoration-success="x_commitment_state == 'fulfilled'"
                                decoration-danger="x_commitment_state == 'cancelled'"/>
                            <field name="x_participation_state" widget="badge"/>
                            <field name="x_document_reference"/>
                            <field name="x_commitment_start_date"/>
                            <field name="x_commitment_end_date"/>
                            <field name="x_recovery_amount"/>
                            <field name="x_responsible_user_id"/>
                        </list>
                        <form string="Employee Training Commitment">
                            <header>
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,generated,signature_requested,signed"
                        readonly="1"/>
                    <button type="action"
                        name="%(action_employee_training_download_generated_pdf)d"
                        string=""
                        title="Download Generated PDF"
                        icon="fa-download"
                        class="btn-link"
                        invisible="not x_pdf_attachment_id"/>
                    <button type="action"
                        name="%(action_employee_training_download_signed_pdf)d"
                        string=""
                        title="Download Signed PDF"
                        icon="fa-file-pdf-o"
                        class="btn-link"
                        invisible="not x_signed_attachment_id"/>
                    <button type="action"
                        name="%(action_employee_training_download_sign_certificate)d"
                        string=""
                        title="Download Sign Certificate"
                        icon="fa-certificate"
                        class="btn-link"
                        invisible="not x_sign_certificate_attachment_id"/>
                </header>
                            <sheet>
                    <div class="mb-2">
                        <button name="%(action_employee_training_generate_f0008_pdf)d"
                            type="action"
                            string="Generate PDF"
                            class="btn btn-primary"
                            invisible="x_state in ('signature_requested', 'signed')"/>
                        <button name="%(action_employee_training_mark_breached)d"
                            type="action"
                            string="Mark Breached"
                            class="btn btn-secondary"
                            invisible="x_commitment_state in ('breached', 'fulfilled', 'cancelled')"/>
                        <button name="%(action_employee_training_mark_fulfilled)d"
                            type="action"
                            string="Mark Fulfilled"
                            class="btn btn-secondary"
                            invisible="x_commitment_state in ('fulfilled', 'cancelled')"/>
                        <button name="%(action_employee_training_mark_cancelled)d"
                            type="action"
                            string="Mark Cancelled"
                            class="btn btn-secondary"
                            invisible="x_commitment_state == 'cancelled'"/>
                        <span class="mx-1"/>
                        <button name="%(action_employee_training_set_in_training)d"
                            type="action"
                            string="Set In Training"
                            class="btn btn-secondary"
                            invisible="x_participation_state != 'allocated'"/>
                        <button name="%(action_employee_training_set_complete)d"
                            type="action"
                            string="Set Complete"
                            class="btn btn-secondary"
                            invisible="x_participation_state not in ('allocated', 'in_training')"/>
                        <button name="%(action_employee_training_set_incomplete)d"
                            type="action"
                            string="Set Incomplete"
                            class="btn btn-secondary"
                            invisible="x_participation_state not in ('allocated', 'in_training')"/>
                    </div>

                                

                                <div class="alert alert-info" role="alert">
                                    Training commitments are employee-specific F-0008 process records. PDF and Sign lifecycle will be added in later Pass 17 slices.
                                </div>
                                <group>
                                    <field name="x_employee_id" readonly="1"/>
                                    <field name="x_training_course_id"/>
                                    <field name="x_training_type_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="x_name" readonly="1"/>
                                    <field name="x_reference_code" readonly="1"/>
                                    <field name="x_document_reference" readonly="1"/>
                                </group>
                                <group string="States">
                                    <field name="x_state" readonly="1"/>
                                    <field name="x_commitment_state" readonly="1"/>
                                    <field name="x_is_breached"/>
                                    <field name="x_participation_state" readonly="1"/>
                                </group>
                                <group string="Commitment and Recovery">
                                    <field name="x_service_commitment_months"/>
                                    <field name="x_commitment_start_date"/>
                                    <field name="x_commitment_end_date" readonly="1"/>
                                    <field name="x_recovery_amount" readonly="1"/>
                                    <field name="x_recovery_amount_words" readonly="1"/>
                                    <field name="x_recovery_required_if_breached" readonly="1"/>
                                    <field name="x_recovery_notes"/>
                                </group>
                                <group string="Artifacts">
                                    <field name="x_pdf_attachment_id" readonly="1"/>
                                    <field name="x_signed_attachment_id" readonly="1"/>
                                    <field name="x_sign_certificate_attachment_id" readonly="1"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_sent_on" readonly="1"/>
                                    <field name="x_signed_on" readonly="1"/>
                                </group>
                                <group string="Odoo Sign">
                                    <field name="x_sign_request_res_id" readonly="1"/>
                                    <field name="x_sign_request_state" readonly="1"/>
                                    <field name="x_sign_request_reference" readonly="1"/>
                                    <field name="x_sign_request_url" readonly="1"/>
                                </group>
                                <group string="Manual Decision">
                                    <field name="x_manual_decision_number"/>
                                    <field name="x_manual_decision_date"/>
                                    <field name="x_manual_decision_attachment_id"/>
                                </group>
                                <group string="Ownership and Notes">
                                    <field name="x_responsible_user_id"/>
                                    <field name="x_notes"/>
                                </group>
                            </sheet>
                        </form>
                    </field>

</page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- HR Configuration Menus                                        -->
    <!-- ============================================================= -->

    <menuitem id="menu_hr_training_configuration_root"
        name="Training"
        parent="hr.menu_human_resources_configuration"
        sequence="95"/>

    <menuitem id="menu_hr_training_types"
        name="Training Types"
        parent="menu_hr_training_configuration_root"
        action="action_hr_training_types"
        sequence="10"/>

    <menuitem id="menu_hr_training_courses"
        name="Training Courses"
        parent="menu_hr_training_configuration_root"
        action="action_hr_training_courses"
        sequence="20"/>

    <menuitem id="menu_hr_employee_training_commitments"
        name="Employee Training Commitments"
        parent="menu_hr_training_configuration_root"
        action="action_employee_training_commitments"
        sequence="30"/>

</odoo>
