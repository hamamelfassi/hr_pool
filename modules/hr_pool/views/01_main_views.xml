<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_pool_list" model="ir.ui.view">
        <field name="name">x_hr.pool.list</field>
        <field name="model">x_hr.pool</field>
        <field name="arch" type="xml">
            <list string="HR Pool Records">
                <field name="x_intake_reference" />
                <field name="x_name" />
                <field name="x_fillout_submission_id" optional="show" />
                <field name="x_candidate_origin" />
                <field name="x_intake_phase" />
                <field name="x_chairman_decision" />
                <field name="x_reviewer_recommendation" />
                <field name="x_reviewer_user_id" />
                <field name="x_conversion_job_id" />
                <field name="x_applicant_id" />
            </list>
        </field>
    </record>

    <record id="view_hr_pool_kanban" model="ir.ui.view">
        <field name="name">x_hr.pool.kanban</field>
        <field name="model">x_hr.pool</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_chairman_decision" highlight_color="id">
                <field name="x_profile_photo" />
                <field name="x_name" />
                <field name="x_intake_reference" />
                <field name="x_candidate_origin" />
                <field name="x_intake_phase" />
                <field name="x_chairman_decision" />
                <field name="x_reviewer_recommendation" />
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="d-flex gap-2 align-items-start">
                                <field name="x_profile_photo" widget="image"
                                    options="{'size':[0,90]}" />
                                <div>
                                    <div class="fw-bold">
                                        <field name="x_name" />
                                    </div>
                                    <div>
                                        <field name="x_intake_reference" />
                                    </div>
                                    <div>
                                        <field name="x_candidate_origin" />
                                    </div>
                                    <div>
                                        <field name="x_intake_phase" />
                                    </div>
                                    <div>
                                        <field name="x_chairman_decision" />
                                    </div>
                                    <div>
                                        <field name="x_reviewer_recommendation" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_pool_kanban_by_phase" model="ir.ui.view">
        <field name="name">x_hr.pool.kanban.by.phase</field>
        <field name="model">x_hr.pool</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_intake_phase" highlight_color="id">
                <field name="x_profile_photo" />
                <field name="x_name" />
                <field name="x_intake_reference" />
                <field name="x_candidate_origin" />
                <field name="x_intake_phase" />
                <field name="x_chairman_decision" />
                <field name="x_reviewer_recommendation" />
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="d-flex gap-2 align-items-start">
                                <field name="x_profile_photo" widget="image"
                                    options="{'size':[0,90]}" />
                                <div>
                                    <div class="fw-bold">
                                        <field name="x_name" />
                                    </div>
                                    <div>
                                        <field name="x_intake_reference" />
                                    </div>
                                    <div>
                                        <field name="x_candidate_origin" />
                                    </div>
                                    <div>
                                        <field name="x_intake_phase" />
                                    </div>
                                    <div>
                                        <field name="x_chairman_decision" />
                                    </div>
                                    <div>
                                        <field name="x_reviewer_recommendation" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_pool_form" model="ir.ui.view">
        <field name="name">x_hr.pool.form</field>
        <field name="model">x_hr.pool</field>
        <field name="arch" type="xml">
            <form string="HR Pool">
                <header>
                    <field name="x_intake_phase" widget="statusbar" options="{'clickable': false}" />
                    <button type="action"
                        name="hr_pool.action_hr_pool_create_conversion_request"
                        string="Convert"
                        class="btn-primary"
                        invisible="not id or x_intake_phase != 'pooling' or x_chairman_decision not in ['approved', 'on_hold'] or x_applicant_id" />
                    <button type="action"
                        name="hr_pool.action_hr_pool_approve_to_pool"
                        string="Approve"
                        invisible="not id or not ((x_intake_phase == 'prescreening' and x_chairman_decision == 'pending') or (x_intake_phase == 'pooling' and x_chairman_decision == 'rejected'))" />
                    <button type="action"
                        name="hr_pool.action_hr_pool_put_on_hold"
                        string="On Hold"
                        invisible="not id or x_intake_phase != 'pooling' or x_chairman_decision != 'approved'" />
                    <button type="action"
                        name="hr_pool.action_hr_pool_reject"
                        string="Reject"
                        invisible="not id or x_intake_phase not in ['prescreening', 'pooling'] or x_chairman_decision not in ['pending', 'approved', 'on_hold']" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_intake_reference" readonly="1" force_save="1" />
                            <field name="x_name" readonly="1" force_save="1" />
                            <field name="x_candidate_origin" />
                            <field name="x_source_channel" />
                        </group>
                        <group>
                            <field name="x_intake_phase"
                                readonly="1"
                                force_save="1"
                                widget="badge"
                                class="fs-5 fw-bold"
                                decoration-warning="x_intake_phase in ['prescreening', 'conversion']"
                                decoration-success="x_intake_phase == 'pooling'"
                                decoration-info="x_intake_phase == 'converted'" />
                            <field name="x_chairman_decision"
                                readonly="1"
                                force_save="1"
                                widget="badge"
                                class="fs-5 fw-bold"
                                decoration-info="x_chairman_decision == 'pending'"
                                decoration-warning="x_chairman_decision == 'on_hold'"
                                decoration-success="x_chairman_decision == 'approved'"
                                decoration-danger="x_chairman_decision == 'rejected'" />
                            <field name="x_reviewer_recommendation" />
                            <field name="x_reviewer_user_id" />
                            <field name="x_conversion_job_id" readonly="1" force_save="1" />
                            <field name="x_applicant_id" readonly="1" force_save="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Identity">
                            <group>
                                <field name="x_profile_photo" widget="image" />
                            </group>
                            <group>
                                <group string="Arabic Name Parts">
                                    <field name="x_first_name_ar" />
                                    <field name="x_father_name_ar" />
                                    <field name="x_grandfather_name_ar" />
                                    <field name="x_surname_ar" />
                                    <field name="x_middle_names_ar" invisible="1" />
                                </group>
                                <group string="English Name Parts">
                                    <field name="x_first_name_en" />
                                    <field name="x_surname_en" />
                                    <field name="x_middle_names_en" invisible="1" />
                                </group>
                            </group>
                        </page>
                        <page string="Personal Information">
                            <group>
                                <field name="x_nationality_id" />
                                <field name="x_national_id" invisible="x_nationality_id == False" />
                                <field name="x_gender" />
                                <field name="x_date_of_birth" />
                                <field name="x_marital_status"/>

                                <field name="x_qualification_type"/>

                                <field name="x_specialisation"/>
                            </group>
                        </page>
                        <page string="Contact Information">
                            <group>
                                <group string="Contact">
                                    <field name="x_phone" />
                                    <field name="x_email" />
                                    <field name="x_address_text" invisible="1" />
                                </group>
                                <group string="Location">
                                    <field name="x_residence_municipality_id"
                                        domain="[('x_location_type', '=', 'municipality')]"
                                        options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                                    <field name="x_residence_district_id" readonly="1" />
                                    <field name="x_residence_region_id" readonly="1" />
                                    <field name="x_residence_location_id" invisible="1" />
                                </group>
                            </group>
                        </page>
                        <page string="Request" name="f0001_job_application">
                            <group>
                                <field name="x_f0001_state"
                                       widget="statusbar"
                                       statusbar_visible="draft,generated,signature_requested,signed"/>
                            </group>

                            <div class="alert alert-info" role="alert">
                                يتم إنشاء نموذج F-0001 من بيانات سجل المرشح الحالي ثم إرساله للمرشح للتوقيع.
                                يجب حفظ بيانات المرشح قبل إنشاء المستند.
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <button type="action"
                                        name="hr_pool.action_hr_pool_generate_f0001_pdf"
                                        string="إنشاء المستند"
                                        class="btn-primary"
                                        invisible="not id or x_f0001_state in ['signature_requested', 'signed']"/>
                                <button type="action"
                                        name="hr_pool.action_hr_pool_send_f0001_sign"
                                        string="إرسال للتوقيع"
                                        icon="fa-pencil-square-o"
                                        class="btn-secondary"
                                        title="إرسال نموذج F-0001 للمرشح للتوقيع"
                                        invisible="x_f0001_state != 'generated' or not x_f0001_pdf_attachment_id"/>
                                <button type="action"
                                        name="hr_pool.action_hr_pool_sync_f0001_sign"
                                        string="مزامنة التوقيع"
                                        icon="fa-refresh"
                                        class="btn-secondary"
                                        title="مزامنة نتيجة توقيع F-0001"
                                        invisible="not x_f0001_sign_request_res_id or x_f0001_state == 'signed'"/>
                                <button type="action"
                                        name="hr_pool.action_hr_pool_download_f0001_generated_pdf"
                                        string="تنزيل المُنشأ"
                                        icon="fa-download"
                                        class="btn-secondary"
                                        title="تنزيل ملف F-0001 المنشأ"
                                        invisible="not x_f0001_pdf_attachment_id"/>
                                <button type="action"
                                        name="hr_pool.action_hr_pool_download_f0001_signed_pdf"
                                        string="تنزيل الموقّع"
                                        icon="fa-download"
                                        class="btn-secondary"
                                        title="تنزيل ملف F-0001 الموقّع"
                                        invisible="not x_f0001_signed_attachment_id"/>
                                <button type="action"
                                        name="hr_pool.action_hr_pool_download_f0001_sign_certificate"
                                        string="تنزيل شهادة التوقيع"
                                        icon="fa-certificate"
                                        class="btn-secondary"
                                        title="تنزيل شهادة توقيع F-0001"
                                        invisible="not x_f0001_sign_certificate_attachment_id"/>
                            </div>

                            <group string="بيانات المستند">
                                <group>
                                    <field name="x_f0001_document_reference"/>
                                    <field name="x_f0001_responsible_user_id"/>
                                    <field name="x_f0001_generated_on"/>
                                    <field name="x_f0001_sent_on"/>
                                    <field name="x_f0001_signed_on"/>
                                </group>
                                <group>
                                    <field name="x_f0001_pdf_attachment_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_f0001_signed_attachment_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_f0001_sign_certificate_attachment_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                            </group>

                            <group string="بيانات طلب التوقيع">
                                <group>
                                    <field name="x_f0001_sign_request_res_id"/>
                                    <field name="x_f0001_sign_request_state"/>
                                    <field name="x_f0001_sign_request_reference"/>
                                </group>
                                <group>
                                    <field name="x_f0001_sign_request_url"/>
                                </group>
                            </group>

                            <group string="ملاحظات">
                                <field name="x_f0001_notes" nolabel="1" placeholder="ملاحظات داخلية حول نموذج F-0001 أو عملية التوقيع."/>
                            </group>
                        </page>

                        <page string="Credentials">
                            <group>
                                <field name="x_education_line_ids">
                                    <list editable="bottom">
                                        <field name="x_sequence" widget="handle" />
                                        <field name="x_qualifying_institution" />
                                        <field name="x_qualification_subject" />
                                        <field name="x_qualification_type" />
                                        <field name="x_graduation_year" />
                                        <field name="x_source_record_id" optional="show" />
                                    </list>
                                </field>
                            </group>
                            <group>
                                <field name="x_employment_line_ids">
                                    <list editable="bottom">
                                        <field name="x_sequence" widget="handle" />
                                        <field name="x_employer_name" />
                                        <field name="x_job_title" />
                                        <field name="x_start_date" />
                                        <field name="x_end_date" />
                                        <field name="x_source_record_id" optional="show" />
                                    </list>
                                </field>
                            </group>
                            <group>
                                <field name="x_skill_line_ids">
                                    <list editable="bottom">
                                        <field name="x_sequence" widget="handle" />
                                        <field name="x_skill_type_id" />
                                        <field name="x_skill_description" />
                                        <field name="x_proficiency_level" />
                                        <field name="x_source_record_id" optional="show" />
                                    </list>
                                </field>
                            </group>
                            <group>
                                <field name="x_language_line_ids">
                                    <list editable="bottom">
                                        <field name="x_sequence" widget="handle" />
                                        <field name="x_language_id" />
                                        <field name="x_language_name" />
                                        <field name="x_working_level_value" />
                                        <field name="x_working_level" optional="hide" />
                                        <field name="x_notes" optional="show" />
                                        <field name="x_source_record_id" optional="show" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Preferences">
                            <group>
                                <field name="x_preferred_role_type_ids" widget="many2many_tags" />
                                <field name="x_preferred_work_type" />
                                <field name="x_preferred_work_municipality_ids"
                                    widget="many2many_tags"
                                    domain="[('x_location_type', '=', 'municipality')]"
                                    options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                                <field name="x_preferred_work_locations" invisible="1" />
                            </group>
                        </page>
                        <page string="Commitments">
                            <group>
                                <field name="x_commitment_line_ids">
                                    <list editable="bottom">
                                        <field name="x_sequence" widget="handle" />
                                        <field name="x_commitment_type_id" />
                                        <field name="x_frequency" />
                                        <field name="x_notes" />
                                        <field name="x_source_record_id" optional="show" />
                                    </list>
                                </field>
                            </group>
                            <group>
                                <field name="x_commitments_description" />
                            </group>
                        </page>
                        <page string="Declarations">
                            <group>
                                <field name="x_accuracy_declaration" />
                                <field name="x_privacy_declaration" />
                                <field name="x_typed_consent_name" invisible="1" />
                            </group>
                        </page>
                        <page string="Conversion Requests">
                            <group>
                                <field name="x_conversion_request_ids" nolabel="1">
                                    <list create="0" delete="0" default_order="id desc">
                                        <field name="x_name" />
                                        <field name="x_state" />
                                        <field name="x_job_id" />
                                        <field name="x_requested_by" />
                                        <field name="x_decided_by" />
                                        <field name="x_applicant_id" />
                                        <field name="x_notes" optional="show" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Integration Metadata">
                            <group>
                                <field name="x_fillout_submission_id" readonly="1" />
                                <field name="x_fillout_form_id" readonly="1" />
                                <field name="x_fillout_submission_time" readonly="1" />
                            </group>
                            <group>
                                <field name="x_fillout_last_updated_at" readonly="1" />
                                <field name="x_source_system" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter open_attachments="True">
                    <field name="message_follower_ids" widget="mail_followers"
                        groups="base.group_user" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_hr_applicant_form_inherit_hr_pool_photo" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.hr.pool.photo</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_title')]/h1/field[@name='partner_name']" position="before">
                <div name="mcep_applicant_title_photo" class="me-3 d-inline-flex align-items-center">
                    <field name="x_profile_photo_1920"
                           widget="image"
                           class="oe_avatar"
                           nolabel="1"
                           options="{'preview_image': 'x_profile_photo_1920', 'size': [96, 96]}"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_hr_applicant_kanban_inherit_hr_pool_photo" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.inherit.hr.pool.photo</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="x_profile_photo_1920"/>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']/field[@name='partner_name']" position="before">
                <div name="mcep_applicant_kanban_photo"
                     class="d-flex justify-content-start mb-2">
                    <field name="x_profile_photo_1920"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'x_profile_photo_1920', 'size': [72, 72]}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>