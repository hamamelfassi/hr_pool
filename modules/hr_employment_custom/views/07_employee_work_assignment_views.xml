<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_work_assignment_list" model="ir.ui.view">
        <field name="name">x.hr.employee.work.assignment.list</field>
        <field name="model">x_hr.employee_work_assignment</field>
        <field name="arch" type="xml">
            <list string="Employee Work Assignments">
                <field name="x_employee_id"/>
                <field name="x_state"
                    widget="badge"
                    decoration-muted="x_state in ('draft', 'superseded')"
                    decoration-info="x_state == 'generated'"
                    decoration-warning="x_state == 'signature_requested'"
                    decoration-success="x_state == 'signed'"
                    decoration-danger="x_state == 'cancelled'"/>
                <field name="x_assignment_location"/>
                <field name="x_assignment_date_from"/>
                <field name="x_assignment_date_to"/>
                <field name="x_document_reference"/>
                <field name="x_responsible_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_employee_work_assignment_form" model="ir.ui.view">
        <field name="name">x.hr.employee.work.assignment.form</field>
        <field name="model">x_hr.employee_work_assignment</field>
        <field name="arch" type="xml">
            <form string="Employee Work Assignment">
                <header>
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,generated,signature_requested,signed"
                        readonly="1"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        This is the Marsellia official work assignment surface for F-0017. PDF generation and Odoo Sign lifecycle will be added in later Pass 20 slices.
                    </div>
                    <group>
                        <field name="x_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_name" readonly="1"/>
                        <field name="x_reference_code" readonly="1"/>
                        <field name="x_document_reference" readonly="1"/>
                    </group>
                    <group string="Assignment Details">
                        <field name="x_assignment_location"/>
                        <field name="x_assignment_date_from"/>
                        <field name="x_assignment_date_to"/>
                        <field name="x_description_purpose"/>
                        <field name="x_employee_notes"/>
                    </group>
                    <group string="Approval Metadata">
                        <field name="x_direct_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Lifecycle Artifacts" invisible="1">
                        <field name="x_pdf_attachment_id" readonly="1"/>
                        <field name="x_signed_attachment_id" readonly="1"/>
                        <field name="x_sign_certificate_attachment_id" readonly="1"/>
                        <field name="x_sign_request_res_id" readonly="1"/>
                        <field name="x_sign_request_state" readonly="1"/>
                        <field name="x_sign_request_reference" readonly="1"/>
                        <field name="x_sign_request_url" readonly="1"/>
                        <field name="x_generated_on" readonly="1"/>
                        <field name="x_sent_on" readonly="1"/>
                        <field name="x_signed_on" readonly="1"/>
                    </group>
                    <group string="Manual Decision">
                        <field name="x_manual_decision_number"/>
                        <field name="x_manual_decision_date"/>
                        <field name="x_manual_decision_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Notes">
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_work_assignments" model="ir.actions.act_window">
        <field name="name">Employee Work Assignments</field>
        <field name="res_model">x_hr.employee_work_assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="action_employee_work_assignment_create" model="ir.actions.act_window">
        <field name="name">New Work Assignment</field>
        <field name="res_model">x_hr.employee_work_assignment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_work_assignment_form"/>
        <field name="target">new</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="view_hr_employee_form_inherit_employee_work_assignments" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.work.assignments</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mcep_employee_work_assignments" string="Assignments">
                    <div class="alert alert-info" role="alert">
                        Work assignments here are Marsellia official F-0017 assignment-form records. They do not create Planning, Project, Timesheet, Attendance, Payroll, Work Entry, Fleet, or GRC records in this pass.
                    </div>
                    <div class="mb-2">
                        <button name="%(action_employee_work_assignment_create)d"
                            type="action"
                            string="New Assignment"
                            class="btn btn-primary"
                            context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_responsible_user_id': uid}"/>
                    </div>
                    <field name="x_work_assignment_ids"
                        nolabel="1"
                        context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_responsible_user_id': uid}">
                        <list create="0">
                            <field name="x_state"
                                widget="badge"
                                decoration-muted="x_state in ('draft', 'superseded')"
                                decoration-info="x_state == 'generated'"
                                decoration-warning="x_state == 'signature_requested'"
                                decoration-success="x_state == 'signed'"
                                decoration-danger="x_state == 'cancelled'"/>
                            <field name="x_assignment_location"/>
                            <field name="x_assignment_date_from"/>
                            <field name="x_assignment_date_to"/>
                            <field name="x_document_reference"/>
                            <field name="x_direct_manager_user_id" optional="show"/>
                            <field name="x_hr_user_id" optional="hide"/>
                            <field name="x_general_manager_user_id" optional="hide"/>
                            <field name="x_responsible_user_id" optional="show"/>
                        </list>
                        <form>
                            <header>
                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="draft,generated,signature_requested,signed"
                                    readonly="1"/>
                            </header>
                            <sheet>
                                <div class="alert alert-info" role="alert">
                                    This is the Marsellia official work assignment surface for F-0017. PDF generation and Odoo Sign lifecycle will be added in later Pass 20 slices.
                                </div>
                                <group>
                                    <field name="x_employee_id" readonly="1" force_save="1"/>
                                    <field name="x_name" readonly="1"/>
                                    <field name="x_reference_code" readonly="1"/>
                                    <field name="x_document_reference" readonly="1"/>
                                </group>
                                <group string="Assignment Details">
                                    <field name="x_assignment_location"/>
                                    <field name="x_assignment_date_from"/>
                                    <field name="x_assignment_date_to"/>
                                    <field name="x_description_purpose"/>
                                    <field name="x_employee_notes"/>
                                </group>
                                <group string="Approval Metadata">
                                    <field name="x_direct_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Lifecycle Artifacts" invisible="1">
                                    <field name="x_pdf_attachment_id" readonly="1"/>
                                    <field name="x_signed_attachment_id" readonly="1"/>
                                    <field name="x_sign_certificate_attachment_id" readonly="1"/>
                                    <field name="x_sign_request_res_id" readonly="1"/>
                                    <field name="x_sign_request_state" readonly="1"/>
                                    <field name="x_sign_request_reference" readonly="1"/>
                                    <field name="x_sign_request_url" readonly="1"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_sent_on" readonly="1"/>
                                    <field name="x_signed_on" readonly="1"/>
                                </group>
                                <group string="Manual Decision">
                                    <field name="x_manual_decision_number"/>
                                    <field name="x_manual_decision_date"/>
                                    <field name="x_manual_decision_attachment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Notes">
                                    <field name="x_notes"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
