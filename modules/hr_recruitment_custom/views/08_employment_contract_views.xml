<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employment_contract_list" model="ir.ui.view">
        <field name="name">x.hr.applicant.employment.contract.list</field>
        <field name="model">x_hr.applicant_employment_contract</field>
        <field name="arch" type="xml">
            <list string="Employment Contracts"
                decoration-muted="x_state == 'draft_data'"
                decoration-info="x_state in ['ready_to_render', 'generated']"
                decoration-success="x_state in ['signed_uploaded', 'ministry_accredited', 'handover_ready']"
                decoration-danger="x_state == 'cancelled'">
                <field name="x_name" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" string="Contract Name"/>
                <field name="x_contract_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" string="Contract Number"/>
                <field name="x_applicant_id" string="Applicant"/>
                <field name="x_state" string="Status" widget="badge"
                    decoration-muted="x_state == 'draft_data'"
                    decoration-info="x_state in ['ready_to_render', 'generated']"
                    decoration-warning="x_state == 'printed'"
                    decoration-success="x_state in ['signed_uploaded', 'ministry_accredited', 'handover_ready']"
                    decoration-danger="x_state == 'cancelled'"/>
                <field name="x_generated_attachment_id" string="Draft PDF"/>
                <field name="x_signed_attachment_id" string="Signed PDF"/>
                <field name="x_ministry_accredited_attachment_id" string="Accredited PDF"/>
            </list>
        </field>
    </record>

    <record id="view_employment_contract_form" model="ir.ui.view">
        <field name="name">x.hr.applicant.employment.contract.form</field>
        <field name="model">x_hr.applicant_employment_contract</field>
        <field name="arch" type="xml">
            <form string="Official Employment Contract">
                <header>
                    <button type="action"
                        name="hr_recruitment_custom.action_employment_contract_update_data_placeholder"
                        string="Update Contract"
                        class="btn-secondary"
                        invisible="not id or x_state in ['printed', 'signed_uploaded', 'ministry_accredited', 'handover_ready', 'cancelled']"/>
                    <button type="action"
                        name="hr_recruitment_custom.action_employment_contract_generate_pdf_placeholder"
                        string="Generate Draft Contract"
                        class="btn-primary"
                        invisible="not id or x_state in ['printed', 'signed_uploaded', 'ministry_accredited', 'handover_ready', 'cancelled']"/>
                    <button type="action"
                        name="hr_recruitment_custom.action_employment_contract_mark_printed"
                        string="Confirm Printed"
                        class="btn-secondary"
                        invisible="not id or x_state != 'generated' or not x_generated_attachment_id"/>
                    <button type="action"
                        name="hr_recruitment_custom.action_employment_contract_confirm_signed_upload"
                        string="Confirm Signed Upload"
                        class="btn-primary"
                        invisible="not id or x_state != 'printed' or not x_signed_attachment_id"/>
                    <button type="action"
                        name="hr_recruitment_custom.action_employment_contract_confirm_ministry_accredited_upload"
                        string="Confirm Ministry Accreditation"
                        class="btn-primary"
                        invisible="not id or x_state != 'signed_uploaded' or not x_ministry_accredited_attachment_id"/>
                    <field name="x_state"
                        widget="statusbar"
                        statusbar_visible="draft_data,ready_to_render,generated,printed,signed_uploaded,ministry_accredited"
                        readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Contract Identity">
                            <field name="x_name" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                            <field name="x_contract_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                            <field name="x_contract_date" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                            <field name="x_contract_day_ar" readonly="1"/>
                            <field name="x_template_code" readonly="1"/>
                            <field name="x_template_version" readonly="1"/>
                            <field name="x_field_map_version" readonly="1"/>
                        </group>
                        <group string="Source Links">
                            <field name="x_applicant_id"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_pool_id" readonly="1"
                               
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_conversion_request_id" readonly="1"
                               
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_board_decision_instance_id" readonly="1"
                               
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_recruitment_document_id" readonly="1"
                               
                                options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Contract Data">
                            <group>
                                <group string="Basic Data">
                                    <field name="x_name" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_state" widget="badge"
                                        decoration-muted="x_state == 'draft_data'"
                                        decoration-info="x_state in ['ready_to_render', 'generated']"
                                        decoration-warning="x_state == 'printed'"
                                        decoration-success="x_state in ['signed_uploaded', 'ministry_accredited', 'handover_ready']"
                                        decoration-danger="x_state == 'cancelled'"
                                        readonly="1"/>
                                    <field name="x_contract_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_contract_date" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                            <field name="x_contract_day_ar" readonly="1"/>
                                </group>
                                <group string="Template and Registry">
                                    <field name="x_template_code" readonly="1"/>
                                    <field name="x_template_version" readonly="1"/>
                                    <field name="x_field_map_version" readonly="1"/>
                                    <field name="x_recruitment_document_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="First Party">
                            <group>
                                <group string="Employer">
                                    <field name="x_company_name_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_company_registration_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_company_address_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                                <group string="Legal Representative">
                                    <field name="x_representative_name_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_representative_title_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_representative_nationality_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                            </group>
                        </page>

                        <page string="Second Party">
                            <group>
                                <group string="Name and Identity">
                                    <field name="x_full_name_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_first_name_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_father_name_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_grandfather_name_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_surname_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_national_id" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                                <group string="Personal Data">
                                    <field name="x_date_of_birth" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_gender" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_marital_status" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_nationality_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_email" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_phone" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" widget="phone"/>
                                    <field name="x_mobile_1" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" widget="phone"/>
                                    <field name="x_mobile_2" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" widget="phone"/>
                                </group>
                            </group>
                        </page>

                        <page string="Identity and Residence">
                            <group>
                                <group string="Identity Document">
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_update_data_placeholder"
                                        string="Update Identity Document"
                                        class="btn-secondary"
                                        invisible="x_state not in ['draft_data', 'ready_to_render']"/>
                                    <field name="x_identity_document_source" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_identity_document_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_identity_document_issue_place" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_identity_document_issue_date" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_identity_document_expiry_date" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                                <group string="Residence">
                                    <field name="x_residence_region_id" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_residence_district_id" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_residence_municipality_id" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_residence_location_id" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_home_phone" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" widget="phone"/>
                                    <field name="x_residence_address_text" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                            </group>
                        </page>

                        <page string="Bank, Qualifications, and Health">
                            <group>
                                <group string="Bank">
                                    <field name="x_bank_name" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_bank_branch" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_bank_account_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_iban" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                                <group string="Qualification, Family, and Health">
                                    <field name="x_qualification_type" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_qualification_subject" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_family_paper_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_family_reference_number" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_next_of_kin_name" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_next_of_kin_phone" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" widget="phone"/>
                                    <field name="x_blood_type" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                            </group>
                        </page>

                        <page string="Job and Duration">
                            <group>
                                <group string="Job">
                                    <field name="x_job_id" readonly="1"/>
                                    <field name="x_job_title_ar" readonly="1"/>
                                    <field name="x_department_id" readonly="1"/>
                                    <field name="x_department_name_ar" readonly="1"/>
                                    <field name="x_work_location" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                                <group string="Contract Duration">
                                    <field name="x_contract_start_date" readonly="1"/>
                                    <field name="x_contract_end_date" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_contract_duration_value" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_contract_duration_unit" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_renewal_duration_value" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_renewal_duration_unit" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                            </group>
                        </page>

                        <page string="Wage and Benefits">
                            <group>
                                <group string="Wage">
                                    <field name="x_monthly_wage_amount" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_monthly_wage_text_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_annual_leave_days" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                                <group string="Benefits and Allowances">
                                    <field name="x_allowances_text_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_benefits_text_ar" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                    <field name="x_compensation_notes" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']"/>
                                </group>
                            </group>
                        </page>

                        <page string="Documents and Printing">
                            <group string="Document Flow">
                                <field name="x_state"
                                    widget="statusbar"
                                    statusbar_visible="draft_data,ready_to_render,generated,printed,signed_uploaded,ministry_accredited"
                                    readonly="1"
                                    nolabel="1"/>
                            </group>
                            <group>
                                <group string="Generated Draft">
                                    <field name="x_generated_attachment_id"
                                        readonly="1"
                                        options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_generated_by_user_id" readonly="1"/>
                                    <field name="x_printed_on" readonly="1"/>
                                    <field name="x_printed_by_user_id" readonly="1"/>
                                </group>
                                <group string="Draft Actions">
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_generate_pdf_placeholder"
                                        string="Generate Draft Contract"
                                        class="btn-primary"
                                        invisible="x_state in ['printed', 'signed_uploaded', 'ministry_accredited', 'handover_ready', 'cancelled']"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_open_generated_pdf"
                                        string="Open Draft"
                                        class="btn-secondary"
                                        icon="fa-external-link"
                                        invisible="not x_generated_attachment_id"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_download_generated_pdf"
                                        string="Download Draft"
                                        class="btn-secondary"
                                        icon="fa-download"
                                        invisible="not x_generated_attachment_id"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_mark_printed"
                                        string="Confirm Printed"
                                        class="btn-secondary"
                                        invisible="x_state != 'generated' or not x_generated_attachment_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Signed Copy">
                                    <field name="x_signed_attachment_id"
                                        readonly="x_state != 'printed'"
                                        domain="[('res_model', 'in', ['hr.applicant', 'x_hr.applicant_employment_contract', False])]"
                                        context="{'default_res_model': 'hr.applicant', 'default_res_id': x_applicant_id}"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_signed_uploaded_on" readonly="1"/>
                                    <field name="x_signed_uploaded_by_user_id" readonly="1"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_confirm_signed_upload"
                                        string="Confirm Signed Upload"
                                        class="btn-primary"
                                        invisible="x_state != 'printed' or not x_signed_attachment_id"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_open_signed_pdf"
                                        string="Open Signed Copy"
                                        class="btn-secondary"
                                        icon="fa-external-link"
                                        invisible="not x_signed_attachment_id"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_download_signed_pdf"
                                        string="Download Signed Copy"
                                        class="btn-secondary"
                                        icon="fa-download"
                                        invisible="not x_signed_attachment_id"/>
                                </group>
                                <group string="Accredited Copy">
                                    <field name="x_ministry_accredited_attachment_id"
                                        readonly="x_state != 'signed_uploaded'"
                                        domain="[('res_model', 'in', ['hr.applicant', 'x_hr.applicant_employment_contract', False])]"
                                        context="{'default_res_model': 'hr.applicant', 'default_res_id': x_applicant_id}"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_ministry_accredited_on" readonly="1"/>
                                    <field name="x_ministry_accredited_by_user_id" readonly="1"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_confirm_ministry_accredited_upload"
                                        string="Confirm Ministry Accreditation"
                                        class="btn-primary"
                                        invisible="x_state != 'signed_uploaded' or not x_ministry_accredited_attachment_id"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_open_ministry_pdf"
                                        string="Open Accredited Copy"
                                        class="btn-secondary"
                                        icon="fa-external-link"
                                        invisible="not x_ministry_accredited_attachment_id"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_download_ministry_pdf"
                                        string="Download Accredited Copy"
                                        class="btn-secondary"
                                        icon="fa-download"
                                        invisible="not x_ministry_accredited_attachment_id"/>
                                </group>
                            </group>
                            <group string="Generation Status">
                                <field name="x_render_status" readonly="1"/>
                                <field name="x_render_error" readonly="1"/>
                            </group>
                        </page>


                        <page string="Sources">
                            <group string="HR Repository Links">
                                <group>
                                    <field name="x_pool_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_conversion_request_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_snapshot_refreshed_on" readonly="1"/>
                                    <field name="x_snapshot_refreshed_by_user_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="x_missing_snapshot_notes" readonly="1"/>
                                </group>
                            </group>

                            <group string="Identity and Residence Sources">
                                <group>
                                    <field name="x_identity_source_submission_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_identity_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_birth_source_submission_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_birth_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="x_residence_source_submission_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_residence_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_family_source_submission_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_family_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                            </group>

                            <group string="Bank, Qualification, and Health Sources">
                                <group>
                                    <field name="x_bank_source_submission_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_bank_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_qualification_source_submission_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_qualification_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="x_health_source_submission_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_health_source_attachment_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Employee Handover">
                            <group>
                                <group string="Handover Readiness">
                                    <field name="x_handover_state" readonly="1"/>
                                    <field name="x_handover_ready" readonly="1"/>
                                    <field name="x_handover_blocking_notes" readonly="1"/>
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_refresh_preboarding_gate"
                                        string="Update Handover Gate Readiness"
                                        class="btn-secondary"
                                        invisible="not id or x_state not in ['signed_uploaded', 'ministry_accredited']"/>
                                </group>
                                <group string="Future Records">
                                    <field name="x_employee_id" readonly="1"/>
                                    <field name="x_hr_contract_id" readonly="1"/>
                                    <field name="x_partner_bank_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes">
                            <group>
                                <field name="x_notes" readonly="x_state not in ['draft_data', 'ready_to_render', 'generated']" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_employment_contracts" model="ir.actions.act_window">
        <field name="name">عقود العمل الرسمية</field>
        <field name="res_model">x_hr.applicant_employment_contract</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
