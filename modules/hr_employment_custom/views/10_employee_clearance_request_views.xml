<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_clearance_line_list" model="ir.ui.view">
        <field name="name">x.hr.employee.clearance.line.list</field>
        <field name="model">x_hr.employee_clearance_line</field>
        <field name="arch" type="xml">
            <list string="Employee Clearance Lines" create="false" delete="false" default_order="x_section_code asc, x_sequence asc">
                <field name="x_section_code"/>
                <field name="x_sequence"/>
                <field name="x_item_code"/>
                <field name="x_item_label_ar"/>
                <field name="x_item_label_en"/>
                <field name="x_notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_employee_clearance_request_list" model="ir.ui.view">
        <field name="name">x.hr.employee.clearance.request.list</field>
        <field name="model">x_hr.employee_clearance_request</field>
        <field name="arch" type="xml">
            <list string="Employee Clearance Requests">
                <field name="x_employee_id"/>
                <field name="x_state"
                    widget="badge"
                    decoration-muted="x_state in ('draft', 'superseded')"
                    decoration-info="x_state == 'generated'"
                    decoration-warning="x_state == 'signature_requested'"
                    decoration-success="x_state == 'signed'"
                    decoration-danger="x_state == 'cancelled'"/>
                <field name="x_reason_for_termination"/>
                <field name="x_last_working_day"/>
                <field name="x_document_reference"/>
                <field name="x_assigned_department_responsible_employee_id" optional="show"/>
                <field name="x_it_responsible_employee_id" optional="hide"/>
                <field name="x_stores_responsible_employee_id" optional="hide"/>
                <field name="x_transport_responsible_employee_id" optional="hide"/>
                <field name="x_finance_responsible_employee_id" optional="hide"/>
                <field name="x_hr_clearance_responsible_employee_id" optional="hide"/>
                <field name="x_hr_user_id" optional="show"/>
                <field name="x_general_manager_user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_employee_clearance_request_form" model="ir.ui.view">
        <field name="name">x.hr.employee.clearance.request.form</field>
        <field name="model">x_hr.employee_clearance_request</field>
        <field name="arch" type="xml">
            <form string="Employee Clearance Request">
                <header>
                    <field name="x_state"
                        widget="statusbar"
                        options="{'clickable': false}"
                        statusbar_visible="draft,generated,signature_requested,signed"
                        readonly="1"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Clearance requests cover F-0020. This slice adds the controlled clearance surface only; line seeding, PDF generation, checkbox Sign fields, and Odoo Sign actions come next.
                    </div>
                    <group>
                        <field name="x_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_name" readonly="1"/>
                        <field name="x_reference_code" readonly="1"/>
                        <field name="x_document_reference" readonly="1"/>
                    </group>
                    <group string="Employee and Termination Details">
                        <field name="x_date_of_joining"/>
                        <field name="x_last_working_day"/>
                        <field name="x_reason_for_termination"/>
                        <field name="x_other_reason_description" invisible="x_reason_for_termination != 'other'"/>
                    </group>
                    <group string="Clearance Responsible Employees">
                        <field name="x_assigned_department_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_it_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_stores_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_transport_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_finance_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_hr_clearance_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Final Approval Users">
                        <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Clearance Items" col="1" colspan="2">
                        <field name="x_clearance_line_ids" nolabel="1" readonly="1">
                            <list create="false" delete="false" default_order="x_section_code asc, x_sequence asc">
                                <field name="x_section_code"/>
                                <field name="x_sequence" string="#"/>
                                <field name="x_item_label_ar" string="Clearance Item Arabic"/>
                                <field name="x_item_label_en" string="Clearance Item English"/>
                                <field name="x_notes" optional="hide"/>
                            </list>
                            <form string="Clearance Item">
                                <group>
                                    <field name="x_section_code" readonly="1"/>
                                    <field name="x_sequence" readonly="1"/>
                                    <field name="x_item_code" readonly="1"/>
                                    <field name="x_item_label_ar" readonly="1"/>
                                    <field name="x_item_label_en" readonly="1"/>
                                    <field name="x_notes"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Lifecycle Artifacts" invisible="1">
                        <field name="x_pdf_attachment_id" readonly="1"/>
                        <field name="x_signed_attachment_id" readonly="1"/>
                        <field name="x_sign_certificate_attachment_id" readonly="1"/>
                        <field name="x_sign_request_res_id" readonly="1"/>
                        <field name="x_sign_request_state" readonly="1"/>
                        <field name="x_sign_request_reference" readonly="1"/>
                        <field name="x_sign_request_url" readonly="1"/>
                        <field name="x_generated_on" readonly="1"/>
                        <field name="x_sent_on" readonly="1"/>
                        <field name="x_signed_on" readonly="1"/>
                    </group>
                    <group string="Notes">
                        <field name="x_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_clearance_requests" model="ir.actions.act_window">
        <field name="name">Employee Clearance Requests</field>
        <field name="res_model">x_hr.employee_clearance_request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="action_employee_clearance_request_create" model="ir.actions.act_window">
        <field name="name">New Clearance Request</field>
        <field name="res_model">x_hr.employee_clearance_request</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_clearance_request_form"/>
        <field name="target">new</field>
        <field name="context">{'default_x_state': 'draft', 'default_x_responsible_user_id': uid}</field>
    </record>

    <record id="view_hr_employee_form_inherit_employee_clearance_requests" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.clearance.requests</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mcep_employee_clearance_requests" string="Clearance">
                    <div class="alert alert-info" role="alert">
                        Clearance requests here are Marsellia official F-0020 records. This pass focuses on governed clearance capture, PDF generation, checkbox Sign items, and eight-role Sign workflow without custody, separation, offboarding, contract closing, payroll, final settlement, approval, or GRC integration.
                    </div>
                    <div class="mb-2">
                        <button name="%(action_employee_clearance_request_create)d"
                            type="action"
                            string="New Clearance Request"
                            class="btn btn-primary"
                            context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_responsible_user_id': uid}"/>
                    </div>
                    <field name="x_clearance_request_ids"
                        nolabel="1"
                        context="{'default_x_employee_id': id, 'default_x_state': 'draft', 'default_x_responsible_user_id': uid}">
                        <list create="0">
                            <field name="x_state"
                                widget="badge"
                                decoration-muted="x_state in ('draft', 'superseded')"
                                decoration-info="x_state == 'generated'"
                                decoration-warning="x_state == 'signature_requested'"
                                decoration-success="x_state == 'signed'"
                                decoration-danger="x_state == 'cancelled'"/>
                            <field name="x_reason_for_termination"/>
                            <field name="x_last_working_day"/>
                            <field name="x_document_reference"/>
                            <field name="x_assigned_department_responsible_employee_id" optional="show"/>
                            <field name="x_it_responsible_employee_id" optional="hide"/>
                            <field name="x_stores_responsible_employee_id" optional="hide"/>
                            <field name="x_transport_responsible_employee_id" optional="hide"/>
                            <field name="x_finance_responsible_employee_id" optional="hide"/>
                            <field name="x_hr_clearance_responsible_employee_id" optional="hide"/>
                            <field name="x_hr_user_id" optional="show"/>
                            <field name="x_general_manager_user_id" optional="show"/>
                        </list>
                        <form>
                            <header>
                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="draft,generated,signature_requested,signed"
                                    readonly="1"/>
                            </header>
                            <sheet>
                                <div class="alert alert-info" role="alert">
                                    Clearance requests cover F-0020. This slice adds the controlled clearance surface only; line seeding, PDF generation, checkbox Sign fields, and Odoo Sign actions come next.
                                </div>
                                <group>
                                    <field name="x_employee_id" readonly="1" force_save="1"/>
                                    <field name="x_name" readonly="1"/>
                                    <field name="x_reference_code" readonly="1"/>
                                    <field name="x_document_reference" readonly="1"/>
                                </group>
                                <group string="Employee and Termination Details">
                                    <field name="x_date_of_joining"/>
                                    <field name="x_last_working_day"/>
                                    <field name="x_reason_for_termination"/>
                                    <field name="x_other_reason_description" invisible="x_reason_for_termination != 'other'"/>
                                </group>
                                <group string="Clearance Responsible Employees">
                                    <field name="x_assigned_department_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_it_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_stores_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_transport_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_finance_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_hr_clearance_responsible_employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Final Approval Users">
                                    <field name="x_hr_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_general_manager_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_responsible_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group string="Clearance Items" col="1" colspan="2">
                                    <field name="x_clearance_line_ids" nolabel="1" readonly="1">
                                        <list create="false" delete="false" default_order="x_section_code asc, x_sequence asc">
                                            <field name="x_section_code"/>
                                            <field name="x_sequence" string="#"/>
                                            <field name="x_item_label_ar" string="Clearance Item Arabic"/>
                                            <field name="x_item_label_en" string="Clearance Item English"/>
                                            <field name="x_notes" optional="hide"/>
                                        </list>
                                        <form string="Clearance Item">
                                            <group>
                                                <field name="x_section_code" readonly="1"/>
                                                <field name="x_sequence" readonly="1"/>
                                                <field name="x_item_code" readonly="1"/>
                                                <field name="x_item_label_ar" readonly="1"/>
                                                <field name="x_item_label_en" readonly="1"/>
                                                <field name="x_notes"/>
                                            </group>
                                        </form>
                                    </field>
                                </group>
                                <group string="Lifecycle Artifacts" invisible="1">
                                    <field name="x_pdf_attachment_id" readonly="1"/>
                                    <field name="x_signed_attachment_id" readonly="1"/>
                                    <field name="x_sign_certificate_attachment_id" readonly="1"/>
                                    <field name="x_sign_request_res_id" readonly="1"/>
                                    <field name="x_sign_request_state" readonly="1"/>
                                    <field name="x_sign_request_reference" readonly="1"/>
                                    <field name="x_sign_request_url" readonly="1"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_sent_on" readonly="1"/>
                                    <field name="x_signed_on" readonly="1"/>
                                </group>
                                <group string="Notes">
                                    <field name="x_notes"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
