<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Pass 7A-6F — Search-based cleanup after detaching legacy XML files.

        This file remains active during the transition so existing installed
        legacy views/actions/menus/seed examples are removed from databases that
        installed earlier scaffold versions.

        It uses search-based deletes so the module can still load if those old
        XML IDs are no longer created by detached files.
    -->

    <!-- Old non-reused menus. Do not delete reused active menu XML IDs such as:
         menu_grc_governance, menu_frameworks, menu_policies, menu_provisions,
         menu_decisions, or menu_sops. These are now owned by the new navigation shell. -->
    <delete model="ir.ui.menu" search="[('name', 'in', [
        'Risk &amp; Controls',
        'Risks',
        'Risk Assessments',
        'Controls',
        'Compliance &amp; Incidents',
        'Compliance Checks',
        'Incidents',
        'Commercial Governance',
        'Clauses',
        'Contract Templates',
        'Tenders',
        'Task Templates'
    ])]"/>

    <!-- Old actions by retired model. -->
    <delete model="ir.actions.act_window" search="[('res_model', 'in', [
        'x_grc.framework',
        'x_grc.policy',
        'x_grc.provision',
        'x_grc.decision',
        'x_grc.sop',
        'x_grc.risk',
        'x_grc.risk_assessment',
        'x_grc.control',
        'x_grc.compliance_check',
        'x_grc.incident',
        'x_grc.contract_template',
        'x_grc.tender',
        'x_grc.clause',
        'x_grc.task_template'
    ])]"/>

    <!-- Old views by retired model. -->
    <delete model="ir.ui.view" search="[('model', 'in', [
        'x_grc.framework',
        'x_grc.policy',
        'x_grc.provision',
        'x_grc.decision',
        'x_grc.sop',
        'x_grc.risk',
        'x_grc.risk_assessment',
        'x_grc.control',
        'x_grc.compliance_check',
        'x_grc.incident',
        'x_grc.contract_template',
        'x_grc.tender',
        'x_grc.clause',
        'x_grc.task_template'
    ])]"/>

    <!-- Retire old SOP/task-template seed examples by code. -->
    <delete model="x_grc.task_template" search="[('x_code', 'in', ['TT-CORP-001', 'TT-SITE-001'])]"/>
    <delete model="x_grc.sop" search="[('x_code', 'in', ['SOP-CORP-001', 'SOP-SITE-001'])]"/>
</odoo>
