            <field name="name">x_source</field>
            <field name="field_description">Submission Source</field>
            <field name="ttype">selection</field>
            <field name="selection">[
                ('manual', 'تحميل يدوي'),
                ('fillout_zite', 'Fillout / Zite'),
                ('n8n', 'تحديث n8n'),
                ('gateway', 'بوابة مرسيليا'),
