<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mcep_legal_document_validity_declaration" model="ir.actions.report">
        <field name="name">F-0004 Legal Documents Validity Declaration</field>
        <field name="model">x_hr.applicant_declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_recruitment_custom.report_mcep_legal_document_validity_declaration_document</field>
        <field name="report_file">hr_recruitment_custom.report_mcep_legal_document_validity_declaration_document</field>
        <field name="paperformat_id" ref="hr_recruitment_custom.paperformat_hr_applicant_tor"/>
        <field name="attachment_use" eval="False"/>
        <field name="print_report_name">'F-0004 Legal Documents Validity Declaration - %s' % (object.x_applicant_id.partner_name or object.x_applicant_id.name or object.x_name or 'Applicant')</field>
    </record>

