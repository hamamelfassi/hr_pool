<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_applicant_declaration_list" model="ir.ui.view">
        <field name="name">x.hr.applicant.declaration.list</field>
        <field name="model">x_hr.applicant_declaration</field>
        <field name="arch" type="xml">
            <list string="Applicant Declarations" create="false" delete="false">
                <field name="x_document_reference" string="Reference" readonly="1" />
                <field name="x_declaration_type" string="Declaration Type" readonly="1" widget="badge" />
                <field name="x_state" string="Status" readonly="1" widget="badge"
                    decoration-muted="x_state in ('draft', 'superseded')"
                    decoration-info="x_state == 'generated'"
                    decoration-warning="x_state == 'signature_requested'"
                    decoration-success="x_state == 'signed'"
                    decoration-danger="x_state == 'cancelled'" />
                <field name="x_generated_on" string="Generated On" readonly="1" />
                <field name="x_sent_on" string="Sent On" readonly="1" />
                <field name="x_signed_on" string="Signed On" readonly="1" />
            </list>
        </field>
    </record>

    <record id="view_applicant_declaration_form" model="ir.ui.view">
        <field name="name">x.hr.applicant.declaration.form</field>
        <field name="model">x_hr.applicant_declaration</field>
        <field name="arch" type="xml">
<form string="Applicant Declaration">
                            <header>
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_generate_f0004_pdf"
                                    string="Generate F-0004 PDF"
                                    class="btn-primary"
                                    invisible="x_declaration_type != 'legal_documents_validity_declaration' or x_state != 'draft'" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_generate_f0007_pdf"
                                    string="Generate F-0007 PDF"
                                    class="btn-primary"
                                    invisible="x_declaration_type != 'policies_compliance_declaration' or x_state in ['signature_requested', 'signed', 'cancelled', 'superseded']" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_generate_f0009_pdf"
                                    string="Generate F-0009 PDF"
                                    class="btn-primary"
                                    invisible="x_declaration_type != 'non_disclosure_agreement' or x_state in ['signature_requested', 'signed', 'cancelled', 'superseded']" />

                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_send_f0004_native_sign"
                                    string="Sign"
                                    class="btn-secondary"
                                    invisible="x_declaration_type != 'legal_documents_validity_declaration' or x_state != 'generated' or not x_pdf_attachment_id" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_send_f0007_native_sign"
                                    string="Sign"
                                    class="btn-secondary"
                                    invisible="x_declaration_type != 'policies_compliance_declaration' or x_state != 'generated' or not x_pdf_attachment_id" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_send_f0009_native_sign"
                                    string="Sign"
                                    class="btn-secondary"
                                    invisible="x_declaration_type != 'non_disclosure_agreement' or x_state != 'generated' or not x_pdf_attachment_id" />

                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_sync_f0004_native_sign_completion"
                                    string="Sync"
                                    class="btn-secondary"
                                    invisible="x_declaration_type != 'legal_documents_validity_declaration' or x_state not in ['signature_requested', 'signed']" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_sync_f0007_native_sign_completion"
                                    string="Sync"
                                    class="btn-secondary"
                                    invisible="x_declaration_type != 'policies_compliance_declaration' or x_state not in ['signature_requested', 'signed']" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_sync_f0009_native_sign_completion"
                                    string="Sync"
                                    class="btn-secondary"
                                    invisible="x_declaration_type != 'non_disclosure_agreement' or x_state not in ['signature_requested', 'signed']" />

                                <field name="x_state"
                                    widget="statusbar"
                                    options="{'clickable': false}"
                                    statusbar_visible="draft,generated,signature_requested,signed"
                                    readonly="1" />

                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_download_generated_pdf"
                                    string=""
                                    title="Download Generated PDF"
                                    icon="fa-download"
                                    class="btn-link"
                                    invisible="not x_pdf_attachment_id" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_download_signed_pdf"
                                    string=""
                                    title="Download Signed PDF"
                                    icon="fa-file-pdf-o"
                                    class="btn-link"
                                    invisible="not x_signed_attachment_id" />
                                <button type="action"
                                    name="hr_recruitment_custom.action_applicant_declaration_download_sign_certificate"
                                    string=""
                                    title="Download Sign Certificate"
                                    icon="fa-certificate"
                                    class="btn-link"
                                    invisible="x_state != 'signed'" />
                            </header>
                            <sheet>
                                <group>
                                    <group string="Declaration Identity">
                                        <field name="x_name" string="Reference" readonly="1" />
                                        <field name="x_applicant_id" string="Applicant" readonly="1" />
                                        <field name="x_declaration_type" string="Declaration Type" readonly="x_state != 'draft'" />
                                        <field name="x_declaration_code" string="Declaration Code" readonly="1" />
                                        <field name="x_document_reference" string="Document Reference" readonly="1" />
                                        <field name="x_sequence" string="Sequence" readonly="1" />
                                    </group>
                                    <group string="Document Lifecycle">
                                        <field name="x_prepared_by_user_id" string="Prepared By" readonly="1" />
                                        <field name="x_prepared_on" string="Prepared On" readonly="1" />
                                        <field name="x_reviewer_user_id" string="Reviewer" readonly="x_state != 'draft'" />
                                        <field name="x_reviewed_on" string="Reviewed On" readonly="1" />
                                        <field name="x_generated_on" string="Generated On" readonly="1" />
                                        <field name="x_sent_on" string="Sent On" readonly="1" />
                                        <field name="x_signed_on" string="Signed On" readonly="1" />
                                        <field name="x_pdf_attachment_id" invisible="1" readonly="1" />
                                        <field name="x_signed_attachment_id" invisible="1" readonly="1" />
                                    </group>
                                </group>

                                <group string="Notes">
                                    <field name="x_notes"
                                        nolabel="1"
                                        readonly="x_state == 'signed'"
                                        placeholder="Internal notes about this declaration." />
                                </group>
                            </sheet>
                            <chatter />
            </form>
        </field>
    </record>
</odoo>
