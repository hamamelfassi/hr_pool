<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Pass 7A-6D/E — Legacy surface retirement.

        This pass retires old scaffold surfaces from the active GRC UI after the
        unified Governance Reference / Provision / Pattern / Variable / Decision
        Template foundation became the active doctrine.

        Deliberately NOT done here:
        - no physical ir.model deletion;
        - no physical ir.model.fields deletion;
        - no removal of installed model/field XML files from the manifest yet.

        Reason:
        Odoo SaaS can block model/field deletion while any view/action/dependency still exists.
        This cleanup first removes active menus/actions/views and old seed examples.
        Physical deletion, if still desired, belongs to a later hard cleanup pass.
    -->

    <!-- Old risk/control/compliance/incident menus -->
    <delete id="menu_risks" model="ir.ui.menu"/>
    <delete id="menu_risk_assessments" model="ir.ui.menu"/>
    <delete id="menu_controls" model="ir.ui.menu"/>
    <delete id="menu_checks" model="ir.ui.menu"/>
    <delete id="menu_incidents" model="ir.ui.menu"/>
    <delete id="menu_grc_risk" model="ir.ui.menu"/>
    <delete id="menu_grc_compliance" model="ir.ui.menu"/>

