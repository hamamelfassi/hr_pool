<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Pass 7A-6I — SaaS-boundary lock cleanup.

        This file intentionally performs only safe active-record cleanup.

        It removes temporary diagnostic/cleanup server actions that were used during
        the Pass 7A-6 retirement investigation.

        It deliberately does NOT delete:
        - ir.model
        - ir.model.fields
        - ir.model.fields.selection

        Reason:
        Odoo Online SaaS/import-module/server-action execution cannot safely emulate
        Odoo upgrade-script model/field removal once registry/source and old database
        schema metadata diverge.

        The retired legacy scaffold has:
        - no active source model/field declarations;
        - no active menus/views/actions/access rows;
        - no business records;
        - no module XMLIDs;
        - no selection XMLIDs;
        - no non-null legacy column data.

        Remaining retired ir.model / ir.model.fields entries, if visible in technical
        metadata, are dormant SaaS database remnants and must be ignored.
    -->

    <delete model="ir.actions.server" search="[('name', 'in', [
        'تدقيق النماذج القديمة',
        'فك ربط بيانات النماذج القديمة',
        'حذف النماذج القديمة نهائياً',
        'تشخيص بيانات أعمدة النماذج القديمة'
    ])]"/>
</odoo>
