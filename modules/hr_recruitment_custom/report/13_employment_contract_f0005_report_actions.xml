<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_employment_contract_f0005_letter" model="report.paperformat">
        <field name="name">F-0005 Employment Contract Letter</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">216</field>
        <field name="page_height">279</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_employment_contract_f0005" model="ir.actions.report">
        <field name="name">F-0005 Employment Contract</field>
        <field name="model">x_hr.applicant_employment_contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_recruitment_custom.report_employment_contract_f0005</field>
        <field name="report_file">hr_recruitment_custom.report_employment_contract_f0005</field>
        <field name="paperformat_id" ref="hr_recruitment_custom.paperformat_employment_contract_f0005_letter"/>
        <field name="attachment_use" eval="False"/>
        <field name="print_report_name">'MCEP-HR-F-0005 - %s' % (object.x_name or 'Employment Contract')</field>
    </record>
</odoo>
