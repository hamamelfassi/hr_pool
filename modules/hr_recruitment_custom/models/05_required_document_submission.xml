<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================= -->
        <!-- Applicant Required Document Submissions                   -->
        <!-- Internal evidence/submission foundation for F-0003 lines.  -->
        <!-- Public continuation/token writeback is intentionally out   -->
        <!-- of scope for Pass 6A-1.                                   -->
        <!-- ========================================================= -->

        <record id="model_x_hr_applicant_required_document_submission" model="ir.model">
            <field name="name">Applicant Required Document Submission</field>
            <field name="model">x_hr.applicant_required_document_submission</field>
            <field name="state">manual</field>
            <field name="is_mail_thread" eval="True" />
            <field name="is_mail_activity" eval="True" />
        </record>

        <record id="field_required_document_submission_x_name" model="ir.model.fields">
            <field name="model_id"
                ref="hr_recruitment_custom.model_x_hr_applicant_required_document_submission" />
            <field name="name">x_name</field>
            <field name="field_description">Submission Name</field>
            <field name="ttype">char</field>
            <field name="required" eval="False" />
        </record>

        <record id="field_required_document_submission_x_submission_sequence" model="ir.model.fields">
            <field name="model_id"
                ref="hr_recruitment_custom.model_x_hr_applicant_required_document_submission" />
            <field name="name">x_submission_sequence</field>
            <field name="field_description">Submission Sequence</field>
            <field name="ttype">integer</field>
            <field name="readonly" eval="True" />
        </record>

        <record id="field_required_document_submission_x_applicant_id" model="ir.model.fields">
            <field name="model_id"
