<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employment_contract_list" model="ir.ui.view">
        <field name="name">x.hr.applicant.employment.contract.list</field>
        <field name="model">x_hr.applicant_employment_contract</field>
        <field name="arch" type="xml">
            <list string="Employment Contracts"
                decoration-muted="x_state == 'draft_data'"
                decoration-info="x_state in ['ready_to_render', 'generated']"
                decoration-success="x_state in ['signed_uploaded', 'ministry_accredited', 'handover_ready']"
                decoration-danger="x_state == 'cancelled'">
                <field name="x_name" string="اسم العقد"/>
                <field name="x_contract_number" string="رقم العقد"/>
                <field name="x_applicant_id" string="المتقدم"/>
                <field name="x_state" string="الحالة" widget="badge"
                    decoration-muted="x_state == 'draft_data'"
                    decoration-info="x_state in ['ready_to_render', 'generated']"
                    decoration-warning="x_state == 'printed'"
                    decoration-success="x_state in ['signed_uploaded', 'ministry_accredited', 'handover_ready']"
                    decoration-danger="x_state == 'cancelled'"/>
                <field name="x_generated_attachment_id" string="المسودة"/>
                <field name="x_signed_attachment_id" string="الموقع"/>
                <field name="x_ministry_accredited_attachment_id" string="المعتمد"/>
            </list>
        </field>
    </record>

    <record id="view_employment_contract_form" model="ir.ui.view">
        <field name="name">x.hr.applicant.employment.contract.form</field>
        <field name="model">x_hr.applicant_employment_contract</field>
        <field name="arch" type="xml">
            <form string="Official Employment Contract">
                <header>
                    <button type="action"
                        name="hr_recruitment_custom.action_employment_contract_update_data_placeholder"
                        string="تحديث بيانات العقد"
                        class="btn-secondary"
                        invisible="not id or x_state in ['ministry_accredited', 'cancelled']"/>
                    <button type="action"
                        name="hr_recruitment_custom.action_employment_contract_generate_pdf_placeholder"
                        string="توليد مسودة العقد"
                        class="btn-primary"
                        invisible="not id or x_state in ['ministry_accredited', 'cancelled']"/>
                    <field name="x_state"
                        widget="statusbar"
                        statusbar_visible="draft_data,ready_to_render,generated,printed,signed_uploaded,ministry_accredited"
                        readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="هوية العقد">
                            <field name="x_name"/>
                            <field name="x_contract_number"/>
                            <field name="x_contract_date"/>
                            <field name="x_template_code" readonly="1"/>
                            <field name="x_template_version" readonly="1"/>
                            <field name="x_field_map_version" readonly="1"/>
                        </group>
                        <group string="روابط المصدر">
                            <field name="x_applicant_id"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_pool_id"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_board_decision_instance_id"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="x_recruitment_document_id"
                                readonly="1"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="بيانات العقد">
                            <group>
                                <group string="بيانات أساسية">
                                    <field name="x_name"/>
                                    <field name="x_state" widget="badge"
                                        decoration-muted="x_state == 'draft_data'"
                                        decoration-info="x_state in ['ready_to_render', 'generated']"
                                        decoration-warning="x_state == 'printed'"
                                        decoration-success="x_state in ['signed_uploaded', 'ministry_accredited', 'handover_ready']"
                                        decoration-danger="x_state == 'cancelled'"
                                        readonly="1"/>
                                    <field name="x_contract_number"/>
                                    <field name="x_contract_date"/>
                                </group>
                                <group string="القالب والسجل">
                                    <field name="x_template_code" readonly="1"/>
                                    <field name="x_template_version" readonly="1"/>
                                    <field name="x_field_map_version" readonly="1"/>
                                    <field name="x_recruitment_document_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="الطرف الأول">
                            <group>
                                <group string="جهة العمل">
                                    <field name="x_company_name_ar"/>
                                    <field name="x_company_registration_number"/>
                                    <field name="x_company_address_ar"/>
                                </group>
                                <group string="الممثل القانوني">
                                    <field name="x_representative_name_ar"/>
                                    <field name="x_representative_title_ar"/>
                                    <field name="x_representative_nationality_ar"/>
                                </group>
                            </group>
                        </page>

                        <page string="الطرف الثاني">
                            <group>
                                <group string="الاسم والهوية">
                                    <field name="x_full_name_ar"/>
                                    <field name="x_first_name_ar"/>
                                    <field name="x_father_name_ar"/>
                                    <field name="x_grandfather_name_ar"/>
                                    <field name="x_surname_ar"/>
                                    <field name="x_national_id"/>
                                </group>
                                <group string="البيانات الشخصية">
                                    <field name="x_date_of_birth"/>
                                    <field name="x_gender"/>
                                    <field name="x_marital_status"/>
                                    <field name="x_nationality_ar"/>
                                    <field name="x_email"/>
                                    <field name="x_phone"/>
                                    <field name="x_mobile_1"/>
                                    <field name="x_mobile_2"/>
                                </group>
                            </group>
                        </page>

                        <page string="الهوية والإقامة">
                            <group>
                                <group string="مستند الهوية">
                                    <field name="x_identity_document_source"/>
                                    <field name="x_identity_document_number"/>
                                    <field name="x_identity_document_issue_place"/>
                                    <field name="x_identity_document_issue_date"/>
                                </group>
                                <group string="الإقامة">
                                    <field name="x_residence_region_id"/>
                                    <field name="x_residence_district_id"/>
                                    <field name="x_residence_municipality_id"/>
                                    <field name="x_residence_location_id"/>
                                    <field name="x_home_phone"/>
                                    <field name="x_residence_address_text"/>
                                </group>
                            </group>
                        </page>

                        <page string="المصرف والمؤهلات والصحة">
                            <group>
                                <group string="المصرف">
                                    <field name="x_bank_name"/>
                                    <field name="x_bank_branch"/>
                                    <field name="x_bank_account_number"/>
                                    <field name="x_iban"/>
                                </group>
                                <group string="المؤهل والأسرة والصحة">
                                    <field name="x_qualification_type"/>
                                    <field name="x_qualification_subject"/>
                                    <field name="x_family_paper_number"/>
                                    <field name="x_family_reference_number"/>
                                    <field name="x_next_of_kin_name"/>
                                    <field name="x_next_of_kin_phone"/>
                                    <field name="x_blood_type"/>
                                </group>
                            </group>
                        </page>

                        <page string="الوظيفة والمدة">
                            <group>
                                <group string="الوظيفة">
                                    <field name="x_job_id"/>
                                    <field name="x_job_title_ar"/>
                                    <field name="x_department_id"/>
                                    <field name="x_department_name_ar"/>
                                    <field name="x_work_location"/>
                                </group>
                                <group string="مدة العقد">
                                    <field name="x_contract_start_date"/>
                                    <field name="x_contract_end_date"/>
                                    <field name="x_contract_duration_value"/>
                                    <field name="x_contract_duration_unit"/>
                                    <field name="x_renewal_duration_value"/>
                                    <field name="x_renewal_duration_unit"/>
                                </group>
                            </group>
                        </page>

                        <page string="الأجر والمزايا">
                            <group>
                                <group string="الأجر">
                                    <field name="x_monthly_wage_amount"/>
                                    <field name="x_monthly_wage_text_ar"/>
                                    <field name="x_annual_leave_days"/>
                                </group>
                                <group string="المزايا والبدلات">
                                    <field name="x_allowances_text_ar"/>
                                    <field name="x_benefits_text_ar"/>
                                    <field name="x_compensation_notes"/>
                                </group>
                            </group>
                        </page>

                        <page string="المستندات والطباعة">
                            <group string="مسار المستند">
                                <field name="x_state"
                                    widget="statusbar"
                                    statusbar_visible="draft_data,ready_to_render,generated,printed,signed_uploaded,ministry_accredited"
                                    readonly="1"
                                    nolabel="1"/>
                            </group>
                            <group>
                                <group string="المسودة المولدة">
                                    <field name="x_generated_attachment_id"
                                        readonly="1"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_generated_on" readonly="1"/>
                                    <field name="x_generated_by_user_id" readonly="1"/>
                                </group>
                                <group string="أوامر المسودة">
                                    <button type="action"
                                        name="hr_recruitment_custom.action_employment_contract_generate_pdf_placeholder"
                                        string="توليد مسودة العقد"
                                        class="btn-primary"
                                        invisible="x_state in ['ministry_accredited', 'cancelled']"/>
                                </group>
                            </group>
                            <group>
                                <group string="النسخة الموقعة">
                                    <field name="x_signed_attachment_id"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_signed_uploaded_on" readonly="1"/>
                                    <field name="x_signed_uploaded_by_user_id" readonly="1"/>
                                </group>
                                <group string="النسخة المعتمدة">
                                    <field name="x_ministry_accredited_attachment_id"
                                        options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="x_ministry_accredited_on" readonly="1"/>
                                    <field name="x_ministry_accredited_by_user_id" readonly="1"/>
                                </group>
                            </group>
                            <group string="حالة التوليد">
                                <field name="x_render_status" readonly="1"/>
                                <field name="x_render_error" readonly="1"/>
                            </group>
                        </page>

                        <page string="الترحيل للموظف">
                            <group>
                                <group string="جاهزية الترحيل">
                                    <field name="x_handover_state" readonly="1"/>
                                    <field name="x_handover_ready" readonly="1"/>
                                    <field name="x_handover_blocking_notes" readonly="1"/>
                                </group>
                                <group string="السجلات المستقبلية">
                                    <field name="x_employee_id" readonly="1"/>
                                    <field name="x_hr_contract_id" readonly="1"/>
                                    <field name="x_partner_bank_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="ملاحظات">
                            <group>
                                <field name="x_notes" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_employment_contracts" model="ir.actions.act_window">
        <field name="name">عقود العمل الرسمية</field>
        <field name="res_model">x_hr.applicant_employment_contract</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
