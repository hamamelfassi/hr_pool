            <field name="x_reference_prefix">MCEP-HR-DEC-HIRE</field>
            <field name="x_default_issuer_title_ar">رئيس مجلس الإدارة</field>
            <field name="x_default_issuer_title_en">Chairman of the Board</field>
            <field name="x_authority_mode">chairman</field>
            <field name="x_active" eval="True"/>
            <field name="x_notes">Initial profile for recruitment hiring board decisions. Authority enforcement is deferred to later recruitment passes.</field>
        </record>
